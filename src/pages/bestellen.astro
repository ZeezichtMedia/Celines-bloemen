---
export const prerender = false;

import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { getVisibleBouquets } from '../lib/data';
import { licht } from '../lib/img';
import { getPublicSettings, checkoutOpen, closedWeekdays } from '../lib/settings';
import { isAuthenticated } from '../lib/auth';
import { siteConfig } from '../config';

const settings = await getPublicSettings();
const open = checkoutOpen(settings);
const dicht = closedWeekdays(settings); // dagen dat de winkel dicht is, 0 = maandag
// Zolang online afrekenen uit staat, is boeketten bestellen van de site gehaald.
// Wie in het beheer is ingelogd ziet de pagina wel, als voorbeeld (en nooit uit de CDN-cache).
const voorbeeld = !open && isAuthenticated(Astro.request.headers.get('cookie'));
if (!open && !voorbeeld) return Astro.redirect('/', 302);
if (voorbeeld) Astro.response.headers.set('Cache-Control', 'private, no-store');

const allBouquets = await getVisibleBouquets();
const bouquets = allBouquets.map((b) => ({
  id: b.id,
  name: b.name,
  color: b.color,
  description: b.description,
  image: b.image,
  photo: licht(b.image),
  prices: {
    klein: b.priceSmall,
    middel: b.priceMid,
    groot: b.priceLarge,
  },
}));
---

<Layout title="Boeket Bestellen - Celine's bloemen" description="Bestel dagverse, handgebonden boeketten vanaf € 17,95. Bezorgd in Arnemuiden, Middelburg, Vlissingen en omgeving." noindex={voorbeeld}>
  {voorbeeld && (
    <p class="fixed bottom-4 left-4 right-4 z-[60] max-w-md rounded-2xl bg-ink px-5 py-3.5 text-[0.88rem] leading-snug text-base shadow-lg sm:right-auto" role="status">
      <strong class="font-medium">Voorbeeld.</strong> Alleen jij ziet deze pagina, omdat je bent ingelogd. Bezoekers zien hem pas als online afrekenen in het beheer aan staat.
    </p>
  )}


  <section class="page-top pb-14 md:pb-20">
    <div class="container-wide grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow reveal">Direct uit de winkel</p>
        <h1 class="reveal mt-6 type-display-xl text-ink">Boeket bestellen</h1>
      </div>
      <p class="reveal type-lead text-ink-muted lg:col-span-4 lg:col-start-9">
        Dagvers, handgebonden en bezorgd op Walcheren en omgeving. Kies je favoriete boeket, selecteer een maat en reken veilig af met iDEAL. Alle prijzen zijn inclusief btw.
        <span class="mt-4 block text-[0.95rem]">Bestel vóór 08:00 en ik bezorg dezelfde dag. Te laat? <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-ink">App</a> of <a href={`tel:${siteConfig.phone}`} class="underline underline-offset-4 hover:text-ink">bel</a> me even.</span>
      </p>
    </div>
  </section>

  <section id="boeketten" class="pb-20 md:pb-28">
    <div class="container-wide">
      <div class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3 lg:gap-x-10">
        {bouquets.map((bouquet, i) => (
          <article
            class:list={['bouquet-card reveal flex flex-col', i % 2 === 1 && 'md:mt-20 lg:mt-0', i % 3 === 1 && 'lg:mt-20']}
            data-name={bouquet.name}
            data-image={bouquet.image}
            data-id={bouquet.id}
            data-price-klein={bouquet.prices.klein}
            data-price-middel={bouquet.prices.middel}
            data-price-groot={bouquet.prices.groot}
          >
            <figure class="group relative aspect-[3/4] overflow-hidden rounded-[1.5rem] bg-base-2">
              <img src={bouquet.photo} alt={`Boeket ${bouquet.name}, ${bouquet.color}`} width="640" height="640" loading={i < 2 ? 'eager' : 'lazy'} class="zoom-img h-full w-full object-cover" />
            </figure>
            <div class="mt-7">
              <p class="eyebrow-ink">{bouquet.color}</p>
              <h2 class="mt-4 font-display text-[clamp(2rem,2.6vw,2.6rem)] leading-tight text-ink">{bouquet.name}</h2>
              <p class="mt-4 max-w-md leading-relaxed text-ink-muted">{bouquet.description}</p>

              <fieldset class="mt-7">
                <legend class="sr-only">Kies een maat voor {bouquet.name}</legend>
                <div class="grid grid-cols-3 gap-2">
                  {(['klein', 'middel', 'groot'] as const).map((size) => (
                    <button
                      type="button"
                      class="size-btn opt px-2 py-3 text-center"
                      data-size={size}
                      data-price={bouquet.prices[size]}
                      aria-pressed={size === 'middel' ? 'true' : 'false'}
                      aria-label={`${size[0].toUpperCase()}${size.slice(1)}, ${bouquet.prices[size]}`}
                    >
                      <span class="block text-[0.7rem] uppercase tracking-[0.16em] opacity-70">{size}</span>
                      <span class="mt-0.5 block text-[0.95rem] font-medium tabular-nums">{bouquet.prices[size]}</span>
                    </button>
                  ))}
                </div>
              </fieldset>

              <button type="button" class="add-to-cart-btn btn-primary mt-4 w-full" aria-label={open ? `Voeg ${bouquet.name} toe aan je winkelwagen` : `Bestel ${bouquet.name} via WhatsApp`}>
                <Icon name={open ? 'ph:shopping-bag-open-light' : 'ph:whatsapp-logo-light'} class="h-5 w-5" />
                <span>{open ? 'In winkelwagen' : 'Bestellen via WhatsApp'}</span>
              </button>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-24 grid gap-8 border-t border-line pt-14 md:mt-32 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <h2 class="reveal type-display-md text-ink">Of iets anders?</h2>
        </div>
        <div class="reveal lg:col-span-5 lg:col-start-8">
          <p class="leading-relaxed text-ink-muted">
            Wil je liever een boeket in jouw kleuren, met jouw favoriete bloemen of in een ander formaat? Dat kan ook. Boeketten op maat maak ik vanaf € 17,95.
          </p>
          <a href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hoi Celine! Ik wil graag een boeket op maat.')}`} target="_blank" rel="noopener noreferrer" class="btn-ghost mt-6"><Icon name="ph:whatsapp-logo-light" class="h-5 w-5" /> Stuur een WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-lg">
    <div class="container-narrow">
      <p class="eyebrow reveal">Seizoensbloemen in de vaas</p>
      <blockquote class="reveal mt-8 type-display-md text-ink heading-pretty">
        Geen massaproductie, maar handwerk. Ik bind met de seizoenen mee, zodat elke bos uniek is.
      </blockquote>
      <p class="reveal mt-8 max-w-lg text-ink-muted">Daardoor kan het boeket in werkelijkheid wat afwijken van het boeket op de foto.</p>
    </div>
  </section>

  <section class="section-lg bg-base-2">
    <div class="container-wide">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow reveal">Verzorgingstips</p>
          <h2 class="reveal mt-6 type-display-md text-ink">Hoe houd je ze het langst mooi?</h2>
        </div>
      </div>
      <div class="reveal-stagger mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {[
          { t: 'Snijd de stelen', d: 'Snijd de stelen schuin af (circa 2 cm) voordat je ze in de vaas zet. Herhaal dit wanneer het nodig is nog een keer.' },
          { t: 'Verwijder blad', d: 'Verwijder bladeren die in het water staan. Zo blijft het water schoner en geniet je langer van je boeket.' },
          { t: 'Geen direct zonlicht', d: 'Zet je boeket op een plek zonder direct zonlicht of tocht. Dat verlengt de bloei aanzienlijk.' },
          { t: 'Schone vaas', d: 'Maak de vaas schoon voordat de bloemen erin gaan. Zet de bloemen daarna met koud water in de schone vaas.' },
        ].map((tip) => (
          <article class="border-t border-ink/15 pt-6">
            <h3 class="font-display text-[1.6rem] leading-tight text-ink">{tip.t}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">{tip.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stap tussen boeket en winkelwagen: waar gaat het naartoe, en een kaartje (Celine, 4 nov 2026) -->
  <dialog id="boeket-stap" data-dicht={dicht.join(',')} class="m-auto w-[min(34rem,calc(100%-2rem))] rounded-[1.5rem] bg-base p-0 text-ink shadow-2xl backdrop:bg-ink/50">
    <form id="boeket-stap-form" method="dialog" class="max-h-[85svh] space-y-6 overflow-y-auto p-6 sm:p-8">
      <div>
        <p class="eyebrow">In je winkelwagen</p>
        <h2 id="stap-titel" class="mt-3 font-display text-[1.9rem] leading-tight"></h2>
      </div>

      <fieldset class="space-y-2">
        <legend class="mb-1.5 block text-[0.75rem] font-medium uppercase tracking-[0.12em] text-ink-muted">Waar gaat het boeket naartoe?</legend>
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-line bg-white p-4 has-[:checked]:border-ink">
          <input type="radio" name="bestemming" value="mij" checked class="mt-1 accent-[#b2765b]" />
          <span><span class="block font-medium">Bij mij</span><span class="block text-[0.85rem] text-ink-muted">Ophalen of bezorgen kies je bij het afrekenen, samen met de rest van je bestelling.</span></span>
        </label>
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-line bg-white p-4 has-[:checked]:border-ink">
          <input type="radio" name="bestemming" value="ander" class="mt-1 accent-[#b2765b]" />
          <span><span class="block font-medium">Naar een ander adres</span><span class="block text-[0.85rem] text-ink-muted">Ik bezorg het boeket bij iemand anders, op de dag die je kiest.</span></span>
        </label>
      </fieldset>

      <div id="stap-adres" class="hidden space-y-3">
        <div><label class="mb-1.5 block text-[0.75rem] font-medium uppercase tracking-[0.12em] text-ink-muted" for="stap-naam">Naam ontvanger</label><input id="stap-naam" class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-accent-500 focus:outline-none" autocomplete="off" maxlength="120" /></div>
        <div><label class="mb-1.5 block text-[0.75rem] font-medium uppercase tracking-[0.12em] text-ink-muted" for="stap-straat">Straat en huisnummer</label><input id="stap-straat" class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-accent-500 focus:outline-none" autocomplete="off" maxlength="300" /></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="mb-1.5 block text-[0.75rem] font-medium uppercase tracking-[0.12em] text-ink-muted" for="stap-postcode">Postcode</label><input id="stap-postcode" class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-accent-500 focus:outline-none" autocomplete="off" maxlength="10" /></div>
          <div><label class="mb-1.5 block text-[0.75rem] font-medium uppercase tracking-[0.12em] text-ink-muted" for="stap-plaats">Plaats</label><select id="stap-plaats" class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-accent-500 focus:outline-none"></select></div>
        </div>
        <div><label class="mb-1.5 block text-[0.75rem] font-medium uppercase tracking-[0.12em] text-ink-muted" for="stap-datum">Bezorgdatum</label><input id="stap-datum" type="date" class="w-full rounded-xl border border-line bg-white px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-accent-500 focus:outline-none" /></div>
        <p class="text-[0.8rem] leading-relaxed text-ink-muted">Bestel je vóór 08:00, dan bezorg ik dezelfde dag. Op dagen dat de winkel dicht is, bezorg ik niet.</p>
      </div>

      <div class="space-y-3">
        <label class="flex cursor-pointer items-center gap-3">
          <input id="stap-kaartje" type="checkbox" class="h-4 w-4 accent-[#b2765b]" />
          <span>Kaartje erbij <span class="text-ink-muted">(+ € 1,50)</span></span>
        </label>
        <textarea id="stap-kaarttekst" rows="3" maxlength="200" placeholder="Tekst op het kaartje" aria-label="Tekst op het kaartje" class="hidden w-full rounded-xl border border-line bg-white px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink-faint focus:border-accent-500 focus:outline-none resize-none"></textarea>
      </div>

      <p id="stap-fout" class="hidden text-[0.9rem] text-red-600" role="alert"></p>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" id="stap-annuleren" class="btn-ghost">Annuleren</button>
        <button type="submit" class="btn-primary"><Icon name="ph:shopping-bag-open-light" class="h-5 w-5" /> In winkelwagen</button>
      </div>
    </form>
  </dialog>

  <div id="cart-toast" class="fixed bottom-6 left-1/2 z-[100] flex -translate-x-1/2 translate-y-4 items-center gap-3 rounded-full bg-ink px-6 py-3.5 text-sm text-base opacity-0 shadow-[0_20px_40px_-20px_rgb(0_0_0/0.5)] transition-all duration-500 pointer-events-none">
    <Icon name="ph:check-light" class="h-5 w-5 text-accent-300" />
    <span id="cart-toast-text">Toegevoegd aan winkelwagen</span>
  </div>

  <CtaSection />

  <script>
    import { addToCart, type Ontvanger } from '../lib/cart';
    import { vroegsteBezorgdag } from '../lib/bestelregels';


    // Online afrekenen staat uit (beheer > Instellingen): bestellen gaat dan via WhatsApp
    const viaWhatsApp = (tekst: string) => {
      if (document.body.dataset.checkout !== 'closed') return false;
      window.open(`https://wa.me/${document.body.dataset.wa}?text=${encodeURIComponent(tekst)}`, '_blank');
      return true;
    };

    // Stap tussen boeket en winkelwagen: bij mij of naar een ander adres, en eventueel een kaartje
    type Boeket = { productId: string; name: string; size: string; price: number; priceLabel: string; image: string };
    let huidig: { boeket: Boeket; knop: HTMLElement } | null = null;
    let zones: { id: number; name: string; cost: string }[] | null = null;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const toonToast = (tekst: string) => {
      const toast = document.getElementById('cart-toast');
      const toastText = document.getElementById('cart-toast-text');
      if (!toast || !toastText) return;
      toastText.textContent = tekst;
      toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2500);
    };

    const openStap = async (boeket: Boeket, knop: HTMLElement) => {
      const dialoog = $<HTMLDialogElement>('boeket-stap');
      huidig = { boeket, knop };
      $('stap-titel').textContent = `${boeket.name} (${boeket.size}), ${boeket.priceLabel}`;
      ($('boeket-stap-form') as HTMLFormElement).reset();
      $('stap-adres').classList.add('hidden');
      $('stap-kaarttekst').classList.add('hidden');
      $('stap-fout').classList.add('hidden');
      const datum = $<HTMLInputElement>('stap-datum');
      datum.min = vroegsteBezorgdag();
      if (!zones) zones = await fetch('/api/delivery-zones').then((r) => r.json()).catch(() => []);
      $<HTMLSelectElement>('stap-plaats').innerHTML = (zones ?? [])
        .map((z) => `<option value="${z.id}">${z.name} (+ € ${Number(z.cost).toFixed(2).replace('.', ',')})</option>`).join('');
      dialoog.showModal();
    };

    const initStap = () => {
      const dialoog = document.getElementById('boeket-stap') as HTMLDialogElement | null;
      if (!dialoog || (dialoog as any).__stapKlaar) return;
      (dialoog as any).__stapKlaar = true;
      const form = $<HTMLFormElement>('boeket-stap-form');
      const fout = (tekst: string) => { $('stap-fout').textContent = tekst; $('stap-fout').classList.remove('hidden'); };

      form.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t.name === 'bestemming') $('stap-adres').classList.toggle('hidden', t.value !== 'ander');
        if (t.id === 'stap-kaartje') $('stap-kaarttekst').classList.toggle('hidden', !t.checked);
      });
      $('stap-annuleren').addEventListener('click', () => dialoog.close());

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!huidig) return;
        const ander = (form.querySelector('input[name="bestemming"]:checked') as HTMLInputElement)?.value === 'ander';
        let ontvanger: Ontvanger | undefined;
        if (ander) {
          const naam = $<HTMLInputElement>('stap-naam').value.trim();
          const adres = $<HTMLInputElement>('stap-straat').value.trim();
          const postcode = $<HTMLInputElement>('stap-postcode').value.trim();
          const zoneId = Number($<HTMLSelectElement>('stap-plaats').value);
          const datum = $<HTMLInputElement>('stap-datum').value;
          const zone = (zones ?? []).find((z) => z.id === zoneId);
          if (naam.length < 2 || adres.length < 3 || postcode.length < 4 || !zone || !datum) return fout('Vul naam, adres, postcode, plaats en bezorgdatum in.');
          if (datum < vroegsteBezorgdag()) return fout('Voor vandaag bezorgen moet je vóór 08:00 bestellen. Kies een andere dag.');
          const dicht = (dialoog.dataset.dicht || '').split(',').filter(Boolean).map(Number);
          const [y, m, d] = datum.split('-').map(Number);
          if (dicht.includes((new Date(Date.UTC(y, m - 1, d)).getUTCDay() + 6) % 7)) return fout('Op die dag is de winkel dicht en wordt er niet bezorgd. Kies een andere dag.');
          ontvanger = { naam, adres, postcode, zoneId, plaats: zone.name, kosten: Number(zone.cost), datum };
        }
        const kaartAan = $<HTMLInputElement>('stap-kaartje').checked;
        const kaartje = kaartAan ? $<HTMLTextAreaElement>('stap-kaarttekst').value.trim() : '';
        if (kaartAan && !kaartje) return fout('Schrijf de tekst voor op het kaartje, of haal het vinkje weg.');

        addToCart({ ...huidig.boeket, ...(ontvanger ? { ontvanger } : {}), ...(kaartje ? { kaartje } : {}) });
        dialoog.close();
        toonToast(`${huidig.boeket.name} (${huidig.boeket.size}) toegevoegd`);
        const label = huidig.knop.querySelector('span') as HTMLElement | null;
        if (label) {
          const prevText = label.textContent;
          label.textContent = 'Toegevoegd';
          setTimeout(() => { label.textContent = prevText; }, 1500);
        }
      });
    };

    const initBestellen = () => {
      const controller = new AbortController();
      const { signal } = controller;

      // Cleanup previous listeners
      const marker = document.getElementById('boeketten');
      if (!marker) return;
      const prev = (marker as any).__bestelCleanup;
      if (prev) prev();
      (marker as any).__bestelCleanup = () => controller.abort();

      // Maatknoppen: de stijl volgt aria-pressed (zie .opt in global.css)
      const setCardSizeActive = (btn: HTMLElement, active: boolean) => {
        btn.setAttribute('aria-pressed', String(active));
      };

      document.querySelectorAll('.bouquet-card').forEach(card => {
        const cardEl = card as HTMLElement;
        const sizeBtns = cardEl.querySelectorAll('.size-btn');

        // Size selection
        sizeBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const size = (btn as HTMLElement).dataset.size!;
            sizeBtns.forEach(b => setCardSizeActive(b as HTMLElement, (b as HTMLElement).dataset.size === size));
          }, { signal });
        });

        // Add to cart
        const addBtn = cardEl.querySelector('.add-to-cart-btn');
        addBtn?.addEventListener('click', () => {
          const name = cardEl.dataset.name || '';
          const image = cardEl.dataset.image || '';
          const activeBtn = cardEl.querySelector('.size-btn[aria-pressed="true"]') as HTMLElement;
          const size = activeBtn?.dataset.size || 'middel';
          const priceStr = activeBtn?.dataset.price || '€ 0,00';
          const price = parseFloat(priceStr.replace('€', '').replace(',', '.').trim());
          if (viaWhatsApp(`Hoi Celine! Ik wil graag het boeket ${name} bestellen, maat ${size} (${priceStr}).`)) return;

          openStap({
            productId: cardEl.dataset.id || name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
            name, size, price, priceLabel: priceStr, image,
          }, addBtn as HTMLElement);
        }, { signal });
      });
    };

    initBestellen();
    initStap();
    document.addEventListener('astro:page-load', () => { initBestellen(); initStap(); });
  </script>
</Layout>
