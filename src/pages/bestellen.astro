---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { siteConfig } from '../config';
import { getVisibleBouquets } from '../lib/data';

const allBouquets = await getVisibleBouquets();

const bouquets = allBouquets.map((b) => ({
  name: b.name,
  color: b.color,
  description: b.description,
  image: b.image,
  prices: {
    klein: b.priceSmall,
    middel: b.priceMid,
    groot: b.priceLarge,
  },
}));
---

<Layout title="Boeket Bestellen - Celine's bloemen" description="Bestel dagverse, handgebonden boeketten. Lokaal bezorgd in de regio Walcheren.">

  <!-- Compact Page Header -->
  <section class="pt-32 pb-8 md:pt-36 md:pb-12 bg-sand-600 px-4 md:px-6">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-block px-4 py-1.5 bg-forest/5 backdrop-blur-md rounded-full border border-forest/10 stagger-reveal">
        <span class="text-[10px] font-sans font-bold uppercase tracking-[0.3em] text-terra-600">Direct uit het atelier</span>
      </div>
      <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl text-forest leading-tight stagger-reveal">
        Boeket <span class="italic text-terra-600">Bestellen</span>
      </h1>
      <p class="font-sans text-base md:text-lg text-forest/70 font-light max-w-xl mx-auto stagger-reveal leading-relaxed">
        Dagvers, handgebonden en lokaal bezorgd op Walcheren. Kies je favoriete boeket, selecteer een maat en reken veilig af met iDEAL.
      </p>
    </div>
  </section>

  <!-- Boeketten Grid -->
  <section id="boeketten" class="py-12 md:py-20 bg-sand-500 px-4 md:px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">

        {bouquets.map((bouquet) => (
          <div
            class="bouquet-card bg-white rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-shadow duration-300 flex flex-col sm:flex-row h-full border border-sand-600/20"
            data-name={bouquet.name}
            data-image={bouquet.image}
            data-price-klein={bouquet.prices.klein}
            data-price-middel={bouquet.prices.middel}
            data-price-groot={bouquet.prices.groot}
          >
            <div class="sm:w-5/12 aspect-[4/3] sm:aspect-auto relative overflow-hidden flex-shrink-0">
               <img
                 src={bouquet.image}
                 alt={`Boeket ${bouquet.name} - ${bouquet.color}`}
                 loading="lazy"
                 class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-500 ease-out"
               />
            </div>
            <div class="sm:w-7/12 p-5 sm:p-6 md:p-8 flex flex-col justify-center">
              <span class="text-[10px] md:text-xs font-sans tracking-[0.3em] uppercase text-sage-500 mb-1.5 font-bold">{bouquet.color}</span>
              <h3 class="font-serif text-2xl md:text-3xl text-forest mb-2">{bouquet.name}</h3>
              <p class="font-sans font-light text-forest/70 mb-4 leading-relaxed text-sm md:text-base">{bouquet.description}</p>

              <!-- Interactive Size Selection -->
              <fieldset class="mb-4">
                <legend class="sr-only">Kies een maat voor {bouquet.name}</legend>
                <div class="grid grid-cols-3 gap-1.5" role="radiogroup">
                  <button
                    type="button"
                    class="size-btn text-center py-2 px-1.5 rounded-lg border transition-all duration-200 cursor-pointer bg-sand-500/50 border-sand-600/30 hover:border-sage-500"
                    data-size="klein"
                    data-price={bouquet.prices.klein}
                    aria-label={`Klein - ${bouquet.prices.klein}`}
                  >
                    <span class="block font-sans text-[10px] uppercase tracking-widest text-forest/50 font-bold">Klein</span>
                    <span class="block font-sans text-xs text-sage-600 font-semibold mt-0.5">{bouquet.prices.klein}</span>
                  </button>
                  <button
                    type="button"
                    class="size-btn text-center py-2 px-1.5 rounded-lg border transition-all duration-200 cursor-pointer bg-forest text-white border-forest"
                    data-size="middel"
                    data-price={bouquet.prices.middel}
                    aria-label={`Middel - ${bouquet.prices.middel}`}
                    aria-pressed="true"
                  >
                    <span class="block font-sans text-[10px] uppercase tracking-widest font-bold text-white/60">Middel</span>
                    <span class="block font-sans text-xs font-semibold text-white mt-0.5">{bouquet.prices.middel}</span>
                  </button>
                  <button
                    type="button"
                    class="size-btn text-center py-2 px-1.5 rounded-lg border transition-all duration-200 cursor-pointer bg-sand-500/50 border-sand-600/30 hover:border-sage-500"
                    data-size="groot"
                    data-price={bouquet.prices.groot}
                    aria-label={`Groot - ${bouquet.prices.groot}`}
                  >
                    <span class="block font-sans text-[10px] uppercase tracking-widest text-forest/50 font-bold">Groot</span>
                    <span class="block font-sans text-xs text-sage-600 font-semibold mt-0.5">{bouquet.prices.groot}</span>
                  </button>
                </div>
              </fieldset>

              <button
                type="button"
                class="add-to-cart-btn group/btn w-full px-6 py-3.5 bg-forest text-white text-xs tracking-widest uppercase hover:bg-terra-600 transition-all duration-300 rounded-full flex items-center justify-center gap-3"
                aria-label={`Voeg ${bouquet.name} toe aan winkelwagen`}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                <span>In winkelwagen</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover/btn:translate-x-1 transition-transform" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </button>
            </div>
          </div>
        ))}

      </div>
    </div>
  </section>

  <!-- Hoe houd je ze het langst mooi -->
  <section class="py-16 md:py-24 bg-white px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12 space-y-4 stagger-reveal">
        <span class="text-terra-600 font-sans text-xs md:text-sm uppercase tracking-widest font-bold">Verzorgingstips</span>
        <h2 class="font-serif text-3xl md:text-5xl text-forest italic leading-tight">Hoe houd je ze het langst mooi?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 stagger-reveal">
        <div class="text-center space-y-3">
          <div class="w-14 h-14 bg-sand-500 rounded-full flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sage-600" aria-hidden="true"><path d="M12 2v6m0 12v-6m-6-6H2m20 0h-4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>
          </div>
          <h3 class="font-serif text-xl text-forest">Snijd de stelen</h3>
          <p class="font-sans text-sm text-forest/70 font-light leading-relaxed">Snijd de stelen schuin af (circa 2 cm) voordat je ze in de vaas zet. Herhaal dit om de twee dagen.</p>
        </div>
        <div class="text-center space-y-3">
          <div class="w-14 h-14 bg-sand-500 rounded-full flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sage-600" aria-hidden="true"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M8 12h8m-4-4v8"/></svg>
          </div>
          <h3 class="font-serif text-xl text-forest">Vers water</h3>
          <p class="font-sans text-sm text-forest/70 font-light leading-relaxed">Ververs het water elke twee dagen. Schoon water voorkomt bacteriegroei en houdt bloemen fris.</p>
        </div>
        <div class="text-center space-y-3">
          <div class="w-14 h-14 bg-sand-500 rounded-full flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sage-600" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          </div>
          <h3 class="font-serif text-xl text-forest">Geen direct zonlicht</h3>
          <p class="font-sans text-sm text-forest/70 font-light leading-relaxed">Zet je boeket op een plek zonder direct zonlicht of tocht. Dat verlengt de bloei aanzienlijk.</p>
        </div>
        <div class="text-center space-y-3">
          <div class="w-14 h-14 bg-sand-500 rounded-full flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sage-600" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          </div>
          <h3 class="font-serif text-xl text-forest">Verwijder blad</h3>
          <p class="font-sans text-sm text-forest/70 font-light leading-relaxed">Verwijder bladeren die onder water staan. Zo blijft het water schoner en genieten je bloemen langer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Filosofie kort -->
  <section class="py-12 md:py-16 bg-sand-600/50 px-4 md:px-6">
    <div class="max-w-4xl mx-auto text-center space-y-4 stagger-reveal">
      <h2 class="font-serif text-3xl md:text-4xl text-forest italic">Seizoensbloemen in de Vaas</h2>
      <p class="font-sans text-forest/70 font-light text-base md:text-lg leading-relaxed max-w-2xl mx-auto">
        Geen massaproductie, maar puur handwerk. Ik bind met de seizoenen mee, zodat elke bos een uniek verhaal vertelt bij jou thuis. Vers, dichtbij en met zorg verpakt.
      </p>
    </div>
  </section>

  <!-- Toast notification -->
  <div id="cart-toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-forest text-white px-6 py-3 rounded-xl shadow-xl font-sans text-sm z-[100] opacity-0 translate-y-4 pointer-events-none transition-all duration-300 flex items-center gap-3">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
    <span id="cart-toast-text">Toegevoegd aan winkelwagen</span>
  </div>

  <CtaSection />

  <script>
    import { addToCart } from '../lib/cart';

    const initBestellen = () => {
      const controller = new AbortController();
      const { signal } = controller;

      // Cleanup previous listeners
      const marker = document.getElementById('boeketten');
      if (!marker) return;
      const prev = (marker as any).__bestelCleanup;
      if (prev) prev();
      (marker as any).__bestelCleanup = () => controller.abort();

      // --- Card size buttons ---
      const setCardSizeActive = (btn: HTMLElement, active: boolean) => {
        const spans = btn.querySelectorAll('span');
        if (active) {
          btn.classList.remove('bg-sand-500/50', 'border-sand-600/30');
          btn.classList.add('bg-forest', 'text-white', 'border-forest');
          btn.setAttribute('aria-pressed', 'true');
          spans[0]?.classList.replace('text-forest/50', 'text-white/60');
          spans[1]?.classList.replace('text-sage-600', 'text-white');
        } else {
          btn.classList.remove('bg-forest', 'text-white', 'border-forest');
          btn.classList.add('bg-sand-500/50', 'border-sand-600/30');
          btn.removeAttribute('aria-pressed');
          spans[0]?.classList.replace('text-white/60', 'text-forest/50');
          spans[1]?.classList.replace('text-white', 'text-sage-600');
        }
      };

      document.querySelectorAll('.bouquet-card').forEach(card => {
        const cardEl = card as HTMLElement;
        const sizeBtns = cardEl.querySelectorAll('.size-btn');

        // Size selection
        sizeBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const size = (btn as HTMLElement).dataset.size!;
            sizeBtns.forEach(b => setCardSizeActive(b as HTMLElement, (b as HTMLElement).dataset.size === size));
          }, { signal });
        });

        // Add to cart
        const addBtn = cardEl.querySelector('.add-to-cart-btn');
        addBtn?.addEventListener('click', () => {
          const name = cardEl.dataset.name || '';
          const image = cardEl.dataset.image || '';
          const activeBtn = cardEl.querySelector('.size-btn[aria-pressed="true"]') as HTMLElement;
          const size = activeBtn?.dataset.size || 'middel';
          const priceStr = activeBtn?.dataset.price || '€ 0,00';
          const price = parseFloat(priceStr.replace('€', '').replace(',', '.').trim());

          addToCart({
            productId: name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
            name,
            size,
            price,
            priceLabel: priceStr,
            image,
          });

          // Show toast
          const toast = document.getElementById('cart-toast');
          const toastText = document.getElementById('cart-toast-text');
          if (toast && toastText) {
            toastText.textContent = `${name} (${size}) toegevoegd`;
            toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(() => {
              toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
              toast.classList.remove('opacity-100', 'translate-y-0');
            }, 2500);
          }

          // Brief button feedback
          const btnEl = addBtn as HTMLElement;
          const origText = btnEl.querySelector('span:nth-child(2)') as HTMLElement;
          if (origText) {
            const prev = origText.textContent;
            origText.textContent = 'Toegevoegd!';
            btnEl.classList.remove('bg-forest');
            btnEl.classList.add('bg-sage-500');
            setTimeout(() => {
              origText.textContent = prev;
              btnEl.classList.remove('bg-sage-500');
              btnEl.classList.add('bg-forest');
            }, 1500);
          }
        }, { signal });
      });
    };

    initBestellen();
    document.addEventListener('astro:page-load', initBestellen);
  </script>
</Layout>
