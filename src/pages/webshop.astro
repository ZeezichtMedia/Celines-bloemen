---
export const prerender = false;

import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { getVisibleProducts } from '../lib/data';
import { getSettings, publicShippingInfo } from '../lib/settings';
import { formatEuro } from '../lib/plans';
import { licht } from '../lib/img';

const [allProducts, settings] = await Promise.all([getVisibleProducts(), getSettings()]);
const shipping = publicShippingInfo(settings);
const intro = shipping.enabled
  ? 'Laat de mooiste vazen, potten en bloemen thuisbezorgen, waar in Nederland je ook woont.'
  : 'De mooiste vazen, potten en bloemen uit de winkel. Bestel online en haal op in Arnemuiden, of laat het bezorgen in de regio.';
const eyebrow = shipping.enabled ? 'Landelijk Bezorgd' : 'Ophalen of lokaal bezorgd';

const products = allProducts.map((p) => ({
  id: p.id,
  name: p.name,
  desc: p.description,
  price: p.price,
  priceLabel: p.priceLabel,
  image: p.image,
  photo: licht(p.image),
  category: p.category,
  soldOut: p.stock != null && p.stock <= 0,
}));

// Derive categories from actual products
const categorySet = new Set(products.map((p) => p.category));
const categories = [
  { id: 'alles', label: 'Alles' },
  ...Array.from(categorySet).map((c) => ({ id: c, label: c.charAt(0).toUpperCase() + c.slice(1) })),
];
---

<Layout title="Webshop - Celine's bloemen" description={intro}>

  <section class="page-top pb-14 md:pb-20">
    <div class="container-wide grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow reveal">{eyebrow}</p>
        <h1 class="reveal mt-6 type-display-xl text-ink">Celine's favorieten</h1>
      </div>
      <div class="reveal lg:col-span-4 lg:col-start-9">
        <p class="type-lead text-ink-muted">{intro}</p>
        <p class="mt-4 text-sm text-ink-faint">
          {shipping.enabled
            ? `Verzendkosten ${formatEuro(shipping.cost)}${shipping.freeFrom != null ? `, gratis vanaf ${formatEuro(shipping.freeFrom)}` : ''}. Ophalen in de winkel kan ook.`
            : 'Ophalen in de winkel is gratis, lokaal bezorgen vanaf € 3,00.'} Alle prijzen inclusief btw.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="container-wide">
      <div class="mb-10 flex flex-wrap gap-2 border-b border-line pb-8 md:mb-14" role="group" aria-label="Filter op categorie">
        {categories.map((cat) => (
          <button
            type="button"
            class="category-btn opt px-5 py-2.5 text-[0.9rem]"
            data-category={cat.id}
            aria-pressed={cat.id === 'alles' ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <div id="product-grid" class="grid grid-cols-2 gap-x-4 gap-y-12 md:grid-cols-3 md:gap-x-8 lg:grid-cols-4">
        {products.map((product, i) => (
          <article
            class="product-card group reveal flex flex-col"
            data-category={product.category}
            data-id={product.id}
            data-name={product.name}
            data-price={product.price}
            data-price-label={product.priceLabel}
            data-image={product.image}
          >
            <figure class="relative aspect-[4/5] overflow-hidden rounded-[1.25rem] bg-base-2">
              {product.soldOut && (
                <span class="absolute left-3 top-3 z-10 rounded-full bg-base/95 px-3 py-1.5 text-[0.7rem] uppercase tracking-[0.14em] text-accent-600">Uitverkocht</span>
              )}
              <img src={product.photo} alt={product.name} loading={i < 4 ? 'eager' : 'lazy'} class="zoom-img h-full w-full object-cover" />
            </figure>
            <div class="mt-5 flex flex-1 flex-col">
              <p class="text-[0.7rem] uppercase tracking-[0.18em] text-ink-faint">{product.category}</p>
              <h2 class="mt-2 font-display text-[1.45rem] leading-tight text-ink">{product.name}</h2>
              <p class="mt-2 line-clamp-2 text-[0.9rem] leading-relaxed text-ink-muted">{product.desc}</p>
              <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                <span class="font-display text-[1.35rem] tabular-nums text-ink">{product.priceLabel}</span>
                {product.soldOut ? (
                  <span class="text-[0.75rem] text-ink-faint">Uitverkocht</span>
                ) : (
                  <button
                    type="button"
                    class="shop-add-btn flex h-11 items-center gap-2 rounded-full border border-ink/20 px-4 text-[0.85rem] font-medium text-ink transition hover:border-ink hover:bg-ink hover:text-base"
                    aria-label={`Voeg ${product.name} toe aan je winkelwagen`}
                  >
                    <Icon name="ph:plus-light" class="h-4 w-4" />
                    <span class="hidden sm:inline">Toevoegen</span>
                  </button>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-lg bg-base-2">
    <div class="container-wide">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow reveal">Zo werkt het</p>
          <h2 class="reveal mt-6 type-display-md text-ink">Hoe werkt bestellen?</h2>
        </div>
        <p class="reveal type-lead text-ink-muted lg:col-span-5 lg:col-start-8">
          Voeg producten toe aan je winkelwagen, reken veilig af met iDEAL en ontvang je bestelling thuis. Simpel en snel.
        </p>
      </div>
      <div class="reveal-stagger mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
        <article class="border-t border-ink/15 pt-6">
          <p class="text-xs tabular-nums text-accent-600">01</p>
          <h3 class="mt-4 font-display text-[1.6rem] leading-tight text-ink">Kies je product</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">Bekijk de collectie en voeg je favorieten toe aan de winkelwagen.</p>
        </article>
        <article class="border-t border-ink/15 pt-6">
          <p class="text-xs tabular-nums text-accent-600">02</p>
          <h3 class="mt-4 font-display text-[1.6rem] leading-tight text-ink">Betaal met iDEAL</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">Reken veilig af via Mollie. iDEAL, creditcard of Bancontact.</p>
        </article>
        <article class="border-t border-ink/15 pt-6">
          <p class="text-xs tabular-nums text-accent-600">03</p>
          <h3 class="mt-4 font-display text-[1.6rem] leading-tight text-ink">{shipping.enabled ? 'Bezorgd aan je deur' : 'Ophalen of bezorgen'}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">{shipping.enabled
            ? 'Je bestelling wordt zorgvuldig ingepakt en binnen 2 tot 4 werkdagen verzonden. Of je haalt hem op in de winkel in Arnemuiden.'
            : 'Je haalt je bestelling op in de winkel in Arnemuiden, of ik bezorg hem bij je thuis in de regio, samen met een boeket als je wilt.'}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-lg">
    <div class="container-wide grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow reveal">Goed om te weten</p>
        <h2 class="reveal mt-6 type-display-md text-ink">Retour en garantie</h2>
      </div>
      <div class="reveal-stagger grid gap-12 md:grid-cols-2 lg:col-span-7 lg:col-start-6">
        <div>
          <h3 class="font-display text-[1.6rem] text-ink">Retourneren</h3>
          <p class="mt-4 text-[0.98rem] leading-relaxed text-ink-muted">
            Niet helemaal tevreden? Je hebt 14 dagen bedenktijd na ontvangst. Neem contact met mij op via WhatsApp of e-mail, dan regelen we de retour samen. Het product moet ongebruikt en in originele staat retour worden gestuurd; de retourkosten zijn voor jou. Zodra het binnen is, ontvang je het aankoopbedrag binnen 14 dagen terug. Verse boeketten en bloemwerk op maat zijn uitgesloten van retour, omdat die snel bederven. Zie de <a href="/algemene-voorwaarden" class="underline underline-offset-4 hover:text-accent-600">algemene voorwaarden</a>.
          </p>
        </div>
        <div>
          <h3 class="font-display text-[1.6rem] text-ink">Garantie</h3>
          <p class="mt-4 text-[0.98rem] leading-relaxed text-ink-muted">
            Alle producten zijn met zorg geselecteerd op kwaliteit. Mocht je toch een beschadigd of defect product ontvangen, neem dan zo snel mogelijk contact op. Ik zorg voor een passende vervanging of terugbetaling. Jouw tevredenheid is mijn prioriteit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div id="shop-toast" class="fixed bottom-6 left-1/2 z-[100] flex -translate-x-1/2 translate-y-4 items-center gap-3 rounded-full bg-ink px-6 py-3.5 text-sm text-base opacity-0 shadow-[0_20px_40px_-20px_rgb(0_0_0/0.5)] transition-all duration-500 pointer-events-none">
    <Icon name="ph:check-light" class="h-5 w-5 text-accent-300" />
    <span id="shop-toast-text">Toegevoegd aan winkelwagen</span>
  </div>

  <CtaSection />

  <script>
    import { addToCart } from '../lib/cart';

    const initWebshop = () => {
      const categoryBtns = document.querySelectorAll('.category-btn');
      const productCards = document.querySelectorAll('.product-card');

      if (!categoryBtns.length) return;

      const controller = new AbortController();
      const { signal } = controller;
      const prev = (categoryBtns[0] as any).__webshopCleanup;
      if (prev) prev();
      (categoryBtns[0] as any).__webshopCleanup = () => controller.abort();

      let activeCategory = 'alles';

      const updateFilter = (category: string) => {
        activeCategory = category;
        categoryBtns.forEach(btn => {
          btn.setAttribute('aria-pressed', String((btn as HTMLElement).dataset.category === activeCategory));
        });

        productCards.forEach(card => {
          const el = card as HTMLElement;
          if (activeCategory === 'alles' || el.dataset.category === activeCategory) {
            el.style.display = '';
          } else {
            el.style.display = 'none';
          }
        });
      };

      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          updateFilter((btn as HTMLElement).dataset.category || 'alles');
        }, { signal });
      });

      // Add to cart buttons
      document.querySelectorAll('.shop-add-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const card = btn.closest('.product-card') as HTMLElement;
          if (!card) return;

          const id = card.dataset.id || '';
          const name = card.dataset.name || '';
          const price = parseFloat(card.dataset.price || '0');
          const priceLabel = card.dataset.priceLabel || '';
          const image = card.dataset.image || '';

          addToCart({ productId: id, name, price, priceLabel, image });

          // Toast
          const toast = document.getElementById('shop-toast');
          const toastText = document.getElementById('shop-toast-text');
          if (toast && toastText) {
            toastText.textContent = `${name} toegevoegd`;
            toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(() => {
              toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
              toast.classList.remove('opacity-100', 'translate-y-0');
            }, 2500);
          }

          // Korte bevestiging op de knop
          const spanEl = btn.querySelector('span') as HTMLElement | null;
          if (spanEl) {
            const prevText = spanEl.textContent;
            spanEl.textContent = 'Toegevoegd';
            setTimeout(() => { spanEl.textContent = prevText; }, 1500);
          }
        }, { signal });
      });

      updateFilter('alles');
    };

    initWebshop();
    document.addEventListener('astro:page-load', initWebshop);
  </script>
</Layout>
