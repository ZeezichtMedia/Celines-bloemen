---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';

const products = [
  {
    id: "signature-vaas",
    name: "Celine's Signature Vaas",
    desc: "Mondgeblazen glas van hoge kwaliteit, perfect voor weelderige veldboeketten. Een tijdloze klassieker die in ieder interieur past.",
    price: 34.95,
    priceLabel: "€ 34,95",
    image: "/images/verhuur/vaas-verhuur.jpeg",
    category: "vazen"
  },
  {
    id: "mini-vaasjes-set",
    name: "Set van 3 Mini-Vaasjes",
    desc: "Eenvoudig glas, ideaal voor de vrolijke overblijvers van je boeket.",
    price: 18.95,
    priceLabel: "€ 18,95",
    image: "/images/verhuur/vaas-verhuur.jpeg",
    category: "vazen"
  },
  {
    id: "ambachtelijke-schaal",
    name: "Ambachtelijke Schaal",
    desc: "Een robuuste basis voor natuurlijke tafelstukken en decoratie.",
    price: 49.95,
    priceLabel: "€ 49,95",
    image: "/images/verhuur/aankleding-tafel.jpeg",
    category: "decoratie"
  },
  {
    id: "luxe-kandelaar-goud",
    name: "Luxe Kandelaar (Goud)",
    desc: "Mat-gouden afwerking voor een subtiel sprankje sfeer op tafel.",
    price: 19.95,
    priceLabel: "€ 19,95",
    image: "/images/verhuur/kandelaar-laag-goud-verhuur.jpeg",
    category: "decoratie"
  },
  {
    id: "slank-decoratiestuk",
    name: "Slank Decoratiestuk",
    desc: "Minimalistisch design kandelaar voor een modern accent in huis.",
    price: 19.95,
    priceLabel: "€ 19,95",
    image: "/images/verhuur/kandelaar-recht-verhuur.jpeg",
    category: "decoratie"
  },
  {
    id: "subtiele-ring",
    name: "Subtiele Ring",
    desc: "Elegante ronde houder voor kaarsen of kleine droogbloemen.",
    price: 14.95,
    priceLabel: "€ 14,95",
    image: "/images/verhuur/kandelaar-rondje-verhuur.jpeg",
    category: "decoratie"
  }
];

const categories = [
  { id: 'alles', label: 'Alles' },
  { id: 'vazen', label: 'Vazen' },
  { id: 'decoratie', label: 'Decoratie' },
];
---

<Layout title="Atelier Webshop - Celine's bloemen" description="Laat mijn favoriete top producten thuisbezorgen door heel Nederland. Van tijdloze vazen tot sfeervolle kandelaren.">

  <!-- Hero Section -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 bg-sand-600 px-4 md:px-6 overflow-hidden relative">
    <div class="absolute inset-0 z-0 opacity-40">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-sand-600 z-10"></div>
      <img src="/images/winkel/winkel-interieur.png" loading="lazy" class="w-full h-full object-cover blur-md scale-105" alt="Interieur bloemenwinkel" />
    </div>

    <div class="relative z-10 max-w-5xl mx-auto text-center space-y-6 md:space-y-8 mt-10">
      <div class="inline-block px-4 py-1.5 bg-white/50 backdrop-blur-md rounded-full border border-forest/10 mt-4 stagger-reveal">
        <span class="text-[10px] font-sans font-bold uppercase tracking-[0.3em] text-terra-600">Landelijk Bezorgd</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl lg:text-8xl text-forest drop-shadow-sm stagger-reveal leading-[1.1] md:leading-[0.9]">Celine's Favorieten</h1>
      <p class="font-sans text-lg md:text-xl text-forest/70 font-light max-w-2xl mx-auto stagger-reveal leading-relaxed">
        Laat mijn favoriete producten bij je thuisbezorgen, waar in Nederland je ook woont. Van tijdloze vazen tot sfeervolle kandelaren.
      </p>
    </div>

    <div class="absolute -bottom-20 -left-20 w-96 h-96 bg-sage-500/20 rounded-full blur-[100px] z-0"></div>
    <div class="absolute top-20 -right-20 w-80 h-80 bg-terra-400/20 rounded-full blur-[100px] z-0"></div>
  </section>

  <!-- Category Filter + Product Grid -->
  <section class="py-16 md:py-32 bg-sand-500/30 px-4 md:px-6 border-b border-sand-600/30">
    <div class="max-w-7xl mx-auto">

      <!-- Category Tabs -->
      <div class="flex flex-wrap justify-center gap-3 mb-12 md:mb-16" role="group" aria-label="Filter op categorie">
        {categories.map((cat) => (
          <button
            class="category-btn px-6 py-2.5 rounded-full text-xs uppercase tracking-widest font-bold transition-all duration-300 border"
            data-category={cat.id}
            aria-label={`Filter: ${cat.label}`}
            aria-pressed={cat.id === 'alles' ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Product Grid -->
      <div id="product-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {products.map((product) => (
          <div
            class="product-card group relative rounded-[2rem] overflow-hidden bg-white shadow-sm hover:shadow-2xl transition-all duration-700 stagger-reveal flex flex-col"
            data-category={product.category}
            data-id={product.id}
            data-name={product.name}
            data-price={product.price}
            data-price-label={product.priceLabel}
            data-image={product.image}
          >
            <div class="relative overflow-hidden aspect-square md:aspect-[4/5]">
               <div class="absolute inset-0 bg-forest/5 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
               <img
                 src={product.image}
                 alt={product.name}
                 loading="lazy"
                 class="w-full h-full object-cover transform scale-100 group-hover:scale-110 transition-transform duration-1000 ease-[cubic-bezier(0.25,1,0.5,1)]"
               />
               <div class="absolute top-4 left-4 md:top-6 md:left-6 z-20 bg-white/90 backdrop-blur-md px-4 py-2 md:px-5 md:py-2.5 rounded-full shadow-lg transform -translate-y-4 opacity-100 md:opacity-0 md:group-hover:translate-y-0 md:group-hover:opacity-100 transition-all duration-500 ease-out">
                 <span class="font-sans font-semibold tracking-wide text-sm text-forest">{product.priceLabel}</span>
               </div>
            </div>

            <div class="p-6 md:p-8 flex flex-col justify-center bg-white border-t border-sand-600/20 flex-grow">
              <span class="text-[10px] uppercase tracking-widest text-sage-500 font-bold mb-2">{product.category}</span>
              <h3 class="font-serif text-2xl md:text-3xl text-forest mb-3 group-hover:text-terra-600 transition-colors duration-300">{product.name}</h3>
              <p class="font-sans font-light text-forest/70 text-sm md:text-base mb-6 leading-relaxed line-clamp-3">{product.desc}</p>

              <div class="mt-auto flex items-center justify-between pt-5 border-t border-sand-600/30">
                 <span class="font-serif text-xl md:text-2xl text-sage-600">{product.priceLabel}</span>
                 <button
                   type="button"
                   class="shop-add-btn flex items-center gap-2 px-5 py-2.5 bg-forest text-white text-xs uppercase tracking-widest font-bold rounded-full hover:bg-terra-600 transition-colors duration-300 shadow-md"
                 >
                   <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                   <span>Toevoegen</span>
                 </button>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Hoe werkt bestellen -->
  <section class="py-16 md:py-24 bg-white px-4 md:px-6">
    <div class="max-w-4xl mx-auto text-center space-y-6 md:space-y-8 stagger-reveal">
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-forest italic">Hoe werkt bestellen?</h2>
      <p class="font-sans text-forest/80 text-base md:text-lg lg:text-xl font-light leading-relaxed">
        Voeg producten toe aan je winkelwagen, reken veilig af met iDEAL en ontvang je bestelling thuis. Simpel en snel.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8 text-left">
        <div class="space-y-3">
          <div class="w-10 h-10 bg-sand-500 rounded-full flex items-center justify-center text-forest font-serif font-bold">1</div>
          <h3 class="font-serif text-xl text-forest">Kies je product</h3>
          <p class="font-sans text-sm text-forest/70 font-light">Bekijk de collectie en voeg je favorieten toe aan de winkelwagen.</p>
        </div>
        <div class="space-y-3">
          <div class="w-10 h-10 bg-sand-500 rounded-full flex items-center justify-center text-forest font-serif font-bold">2</div>
          <h3 class="font-serif text-xl text-forest">Betaal met iDEAL</h3>
          <p class="font-sans text-sm text-forest/70 font-light">Reken veilig af via Mollie. iDEAL, creditcard of Bancontact.</p>
        </div>
        <div class="space-y-3">
          <div class="w-10 h-10 bg-sand-500 rounded-full flex items-center justify-center text-forest font-serif font-bold">3</div>
          <h3 class="font-serif text-xl text-forest">Bezorgd aan je deur</h3>
          <p class="font-sans text-sm text-forest/70 font-light">Je bestelling wordt zorgvuldig ingepakt en door heel Nederland bezorgd.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Retour & Garantie -->
  <section class="py-16 md:py-24 bg-sand-500/30 px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12 space-y-4 stagger-reveal">
        <h2 class="font-serif text-3xl md:text-4xl text-forest italic">Retour & Garantie</h2>
        <div class="h-1 w-20 bg-terra-400 mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 stagger-reveal">
        <div class="bg-white p-8 rounded-2xl shadow-sm">
          <h3 class="font-serif text-2xl text-forest mb-4">Retourneren</h3>
          <p class="font-sans font-light text-forest/80 leading-relaxed">
            Niet helemaal tevreden? Neem binnen 14 dagen contact met mij op via WhatsApp of e-mail. Samen zoeken we naar een passende oplossing. Het product moet ongebruikt en in originele staat retour worden gestuurd. Na ontvangst en goedkeuring ontvang je het aankoopbedrag terug.
          </p>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-sm">
          <h3 class="font-serif text-2xl text-forest mb-4">Garantie</h3>
          <p class="font-sans font-light text-forest/80 leading-relaxed">
            Alle producten zijn met zorg geselecteerd op kwaliteit. Mocht je toch een beschadigd of defect product ontvangen, neem dan zo snel mogelijk contact op. Ik zorg voor een passende vervanging of terugbetaling. Jouw tevredenheid is mijn prioriteit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Toast -->
  <div id="shop-toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-forest text-white px-6 py-3 rounded-xl shadow-xl font-sans text-sm z-[100] opacity-0 translate-y-4 pointer-events-none transition-all duration-300 flex items-center gap-3">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
    <span id="shop-toast-text">Toegevoegd aan winkelwagen</span>
  </div>

  <CtaSection />

  <script>
    import { addToCart } from '../lib/cart';

    const initWebshop = () => {
      const categoryBtns = document.querySelectorAll('.category-btn');
      const productCards = document.querySelectorAll('.product-card');

      if (!categoryBtns.length) return;

      const controller = new AbortController();
      const { signal } = controller;
      const prev = (categoryBtns[0] as any).__webshopCleanup;
      if (prev) prev();
      (categoryBtns[0] as any).__webshopCleanup = () => controller.abort();

      let activeCategory = 'alles';

      const updateFilter = (category: string) => {
        activeCategory = category;
        categoryBtns.forEach(btn => {
          const cat = (btn as HTMLElement).dataset.category;
          const isActive = cat === activeCategory;
          if (isActive) {
            btn.classList.add('bg-forest', 'text-white', 'border-forest');
            btn.classList.remove('bg-white', 'text-forest', 'border-sand-600/50');
          } else {
            btn.classList.remove('bg-forest', 'text-white', 'border-forest');
            btn.classList.add('bg-white', 'text-forest', 'border-sand-600/50');
          }
          btn.setAttribute('aria-pressed', String(isActive));
        });

        productCards.forEach(card => {
          const el = card as HTMLElement;
          if (activeCategory === 'alles' || el.dataset.category === activeCategory) {
            el.style.display = '';
          } else {
            el.style.display = 'none';
          }
        });
      };

      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          updateFilter((btn as HTMLElement).dataset.category || 'alles');
        }, { signal });
      });

      // Add to cart buttons
      document.querySelectorAll('.shop-add-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const card = btn.closest('.product-card') as HTMLElement;
          if (!card) return;

          const id = card.dataset.id || '';
          const name = card.dataset.name || '';
          const price = parseFloat(card.dataset.price || '0');
          const priceLabel = card.dataset.priceLabel || '';
          const image = card.dataset.image || '';

          addToCart({ productId: id, name, price, priceLabel, image });

          // Toast
          const toast = document.getElementById('shop-toast');
          const toastText = document.getElementById('shop-toast-text');
          if (toast && toastText) {
            toastText.textContent = `${name} toegevoegd`;
            toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');
            setTimeout(() => {
              toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
              toast.classList.remove('opacity-100', 'translate-y-0');
            }, 2500);
          }

          // Button feedback
          const spanEl = btn.querySelector('span') as HTMLElement;
          if (spanEl) {
            const prev = spanEl.textContent;
            spanEl.textContent = 'Toegevoegd!';
            (btn as HTMLElement).classList.replace('bg-forest', 'bg-sage-500');
            setTimeout(() => {
              spanEl.textContent = prev;
              (btn as HTMLElement).classList.replace('bg-sage-500', 'bg-forest');
            }, 1500);
          }
        }, { signal });
      });

      updateFilter('alles');
    };

    initWebshop();
    document.addEventListener('astro:page-load', initWebshop);
  </script>
</Layout>
