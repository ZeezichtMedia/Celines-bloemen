---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';
import { siteConfig } from '../config';

const mogelijk = ['Bruidsboeket', 'Bruidegomscorsage', 'Backdrop', 'Vazen', 'Tafeldecoratie', 'Autobloemstuk'];

const stappen = [
  { t: 'Inspiratie opdoen', d: "Verzamel Pinterest-borden, foto's en kleuren. Ik denk graag mee over de perfecte bloemen voor jullie dag." },
  { t: 'Kennismakingsgesprek', d: 'We zitten samen om tafel, onder het genot van een kopje koffie, om al jullie wensen te bespreken.' },
  { t: 'Jullie bruiloft!', d: 'Ik maak de dag ervoor al het bloemwerk, zodat jullie alleen nog maar hoeven te genieten.' },
];

const uitgelicht = [
  { t: 'Kandelaren', d: 'Mooie rosé gouden kandelaren in verschillende hoogtes, een prachtige aanvulling op jullie dinertafels. Kaarsen zijn niet inbegrepen.', img: '/images/opt/kandelaren-800.webp', alt: 'Drie gouden kandelaren in verschillende hoogtes' },
  { t: 'Backdrop', d: 'Een mooie houten backdrop inclusief doeken. Makkelijk in en uit elkaar te halen, dus prima zelf op te bouwen voor de ceremonie of als fotobooth.', img: '/images/opt/backdrop-laken-800.webp', alt: 'Houten backdrop met witte doeken in een tuin' },
  { t: 'Vazen & vaasjes', d: 'Mooie glazen vaasjes waar de bloemen perfect in uitkomen, en grote vazen van 30 en 40 cm voor een echte eyecatcher.', img: '/images/opt/vaas-800.webp', alt: 'Glazen vaas met ribbels' },
];

const alles = [
  { name: 'Kandelaren', desc: 'Mooie rosé gouden kandelaren in verschillende hoogtes.', spec: 'Exclusief kaarsen' },
  { name: 'Vaasjes', desc: 'Mooie glazen vaasjes waar de bloemen perfect in uitkomen.', spec: 'Rond, smal en hoog' },
  { name: 'Vazen', desc: 'Mooie grote vazen voor een eyecatcher boeket.', spec: '30 cm (2x) en 40 cm (2x)' },
  { name: 'Backdrop', desc: 'Een mooie houten backdrop inclusief doeken, makkelijk in en uit elkaar te halen.', spec: '1 beschikbaar' },
  { name: 'Spiegel', desc: "Een mooie grote spiegel voor de perfecte foto's.", spec: '180 x 90 cm, 1 beschikbaar' },
  { name: 'Lintenslinger', desc: 'Een vrolijke lintenslinger van 100 meter lang.', spec: 'Licht roze, fuchsia roze en groen' },
];
---

<Layout title="Bruiloften & Verhuur - Celine's bloemen" description="Bruidsboeket, corsage, backdrop, tafeldecoratie en autobloemstuk. Plus de verhuur van kandelaren, vazen, spiegel en lintenslinger." heroTone="light">

  <section class="grain relative flex min-h-[92svh] flex-col overflow-hidden bg-dark text-base">
    <div class="absolute inset-0">
      <div class="reveal-image absolute inset-0">
        <img src="/images/opt/backdrop-bruiloft-1400.webp" alt="Bruidspaar onder een backdrop met doeken en bloemen" fetchpriority="high" class="ken-burns h-full w-full object-cover object-[60%_center]" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-dark/60 via-dark/10 to-dark/90"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-dark/70 via-dark/20 to-transparent"></div>
    </div>
    <div class="container-wide relative z-10 flex flex-1 flex-col justify-end pb-16 pt-44 md:pb-24">
      <div class="max-w-3xl">
        <p class="eyebrow-bone reveal">Jullie de dag, ik de bloemen</p>
        <h1 class="reveal mt-7 type-display-xl text-base">Bruiloften & verhuur</h1>
        <p class="reveal mt-7 max-w-xl type-lead text-base/85">
          Gefeliciteerd, jullie gaan trouwen! Hierbij horen natuurlijk bloemen. Als bruidsbloemist denk ik graag met jullie mee voor de grote dag.
        </p>
        <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="#brochure" class="btn-primary btn-light">Vraag de brochure aan <Icon name="ph:arrow-down-light" class="h-4 w-4" /></a>
          <a href="#verhuur-aanbod" class="btn-ghost btn-ghost-light">Bekijk het verhuuraanbod</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-lg">
    <div class="container-wide">
      <div class="max-w-[1100px]">
        <p class="eyebrow reveal">Bruidsbloemen</p>
        <h2 class="reveal mt-8 type-display-lg text-ink">Het bloemwerk maakt de sfeer op een bruiloft.</h2>
      </div>
      <div class="mt-12 grid gap-10 md:mt-16 lg:grid-cols-12">
        <div class="reveal prose-celine lg:col-span-6">
          <p>We kijken samen naar de kleuren, sfeer en mogelijkheden op jullie bruiloft. Samen zorgen we ervoor dat het bloemwerk helemaal past bij jullie.</p>
          <p>Door bloemen toe te voegen aan de styling krijg je een persoonlijk geheel. Met bloemen maak je de bruiloft echt jullie bruiloft! Of het nou wit, roze, pastel of felle kleuren zijn, ik ga graag voor jullie aan de slag.</p>
        </div>
        <div class="reveal lg:col-span-5 lg:col-start-8">
          <ul class="border-t border-ink/12">
            {mogelijk.map((m) => (
              <li class="flex items-center justify-between border-b border-ink/12 py-3.5">
                <span class="font-display text-[1.45rem] text-ink">{m}</span>
                <Icon name="ph:flower-light" class="h-5 w-5 text-accent-500" />
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-ink-faint">en zoveel meer mogelijkheden</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="container-wide grid gap-14 md:grid-cols-12 md:gap-8">
      <article class="md:col-span-7">
        <figure class="reveal-image aspect-[4/3] overflow-hidden rounded-[1.5rem]">
          <img src="/images/opt/bruidsboeket-hand-1400.webp" alt="Bruidsboeket in de hand van de bruid naast de bruidegom" loading="lazy" class="h-full w-full object-cover" />
        </figure>
        <h2 class="reveal mt-8 type-display-sm text-ink">Puur natuur bruidsbloemen</h2>
        <p class="reveal mt-4 max-w-lg leading-relaxed text-ink-muted">
          Het bruidsboeket is het meest persoonlijke bloemwerk van de dag. Of jullie nu kiezen voor droogbloemen, verse bloemen of een combinatie: ik ga graag met jullie aan de slag. Vergeet ook de corsage voor de bruidegom niet, ik maak alles op maat.
        </p>
      </article>
      <article class="md:col-span-4 md:col-start-9 md:mt-40">
        <figure class="reveal-image aspect-[3/4] overflow-hidden rounded-[1.5rem]">
          <img src="/images/opt/tafel-loper-kandelaar-800.webp" alt="Trouwtafel met een roze loper, vaasjes met bloemen en kandelaren" loading="lazy" class="h-full w-full object-cover" />
        </figure>
        <h2 class="reveal mt-8 type-display-sm text-ink">Verhuur eyecatchers</h2>
        <p class="reveal mt-4 leading-relaxed text-ink-muted">
          Vazen, kandelaars, backdrops en decoratie: huur het erbij zodat alles naadloos aansluit bij jullie stijl en de bloemen die ik voor jullie maak. Geen gedoe, geen stress.
        </p>
      </article>
    </div>
  </section>

  <section class="section-lg bg-base-2">
    <div class="container-wide grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <p class="eyebrow reveal">Van aanvraag tot trouwdag</p>
          <h2 class="reveal mt-6 type-display-lg text-ink">Zo werkt het</h2>
          <figure class="reveal-image mt-10 hidden aspect-[4/5] overflow-hidden rounded-[1.5rem] lg:block">
            <img src="/images/opt/corsage-800.webp" alt="Corsage met een perzikkleurige roos op een blauw pak" loading="lazy" class="h-full w-full object-cover" />
          </figure>
        </div>
      </div>
      <ol class="space-y-16 lg:col-span-6 lg:col-start-7 lg:pt-28">
        {stappen.map((s, i) => (
          <li class="reveal border-t border-ink/15 pt-8">
            <p class="font-display text-[4.5rem] leading-none text-accent-400">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-6 type-display-sm text-ink">{s.t}</h3>
            <p class="mt-4 max-w-md leading-relaxed text-ink-muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="verhuur-aanbod" class="section-lg scroll-mt-24">
    <div class="container-wide">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow reveal">Wat ik verhuur</p>
          <h2 class="reveal mt-6 type-display-lg text-ink">Het verhuuraanbod</h2>
        </div>
        <p class="reveal leading-relaxed text-ink-muted lg:col-span-5 lg:col-start-8">
          Naast dat ik al het bloemwerk kan maken, heb ik ook veel items in de verhuur. Zo kun je naast de bloemen ook de vaasjes en kandelaren huren bij Celine's Bloemen. Naast vazen, kandelaren en een backdrop heb ik ook een mooie grote spiegel en een lintenslinger in de verhuur.
        </p>
      </div>

      <div class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
        {uitgelicht.map((u, i) => (
          <article class:list={['reveal', i === 1 && 'md:mt-16']}>
            <figure class="group aspect-[4/5] overflow-hidden rounded-[1.5rem] bg-base-2">
              <img src={u.img} alt={u.alt} loading="lazy" class="zoom-img h-full w-full object-cover" />
            </figure>
            <h3 class="mt-7 type-display-sm text-ink">{u.t}</h3>
            <p class="mt-3 leading-relaxed text-ink-muted">{u.d}</p>
          </article>
        ))}
      </div>

      <div class="mt-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h3 class="reveal type-display-sm text-ink">Alles wat ik verhuur</h3>
          <p class="reveal mt-4 text-ink-muted">Benieuwd naar de prijzen? Die staan in de brochure.</p>
          <a href="#brochure" class="reveal btn-link mt-6">Vraag de brochure aan <Icon name="ph:arrow-down-light" class="h-4 w-4" /></a>
        </div>
        <ul class="reveal lg:col-span-8 border-t border-ink/12">
          {alles.map((item) => (
            <li class="grid gap-1 border-b border-ink/12 py-5 sm:grid-cols-12 sm:items-baseline sm:gap-6">
              <span class="font-display text-[1.45rem] text-ink sm:col-span-3">{item.name}</span>
              <span class="text-ink-muted sm:col-span-6">{item.desc}</span>
              <span class="text-sm text-accent-600 sm:col-span-3 sm:text-right">{item.spec}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="pb-6">
    <div class="container-wide grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-5">
      <figure class="reveal-image col-span-2 aspect-[16/10] overflow-hidden rounded-[1.25rem] md:col-span-7"><img src="/images/opt/backdrop-luxe-1400.webp" loading="lazy" alt="Backdrop met doeken en droogbloemen op een kleed in de tuin" class="h-full w-full object-cover" /></figure>
      <figure class="reveal-image aspect-[4/5] overflow-hidden rounded-[1.25rem] md:col-span-5 md:aspect-[8/7]"><img src="/images/opt/trouwtafel-lavendel-800.webp" loading="lazy" alt="Gedekte tafel met bloemen in een lavendelveld" class="h-full w-full object-cover" /></figure>
      <figure class="reveal-image aspect-[4/5] overflow-hidden rounded-[1.25rem] md:hidden"><img src="/images/opt/verhuur-veld-800.webp" loading="lazy" alt="Tafel met vaas en kandelaren in een veld" class="h-full w-full object-cover" /></figure>
      <figure class="reveal-image aspect-[4/5] overflow-hidden rounded-[1.25rem] md:col-span-4"><img src="/images/opt/trouwboog-bank-800.webp" loading="lazy" alt="Houten trouwboog met doeken en bloemen, met een rotan bankje op een kleed" class="h-full w-full object-cover" /></figure>
      <figure class="reveal-image aspect-[4/5] overflow-hidden rounded-[1.25rem] md:hidden"><img src="/images/opt/tafel-loper-800.webp" loading="lazy" alt="Vaasje met bloemen op een tafel met een roze loper" class="h-full w-full object-cover" /></figure>
      <figure class="reveal-image col-span-2 aspect-[16/10] overflow-hidden rounded-[1.25rem] md:col-span-8"><img src="/images/opt/bruidsboeket-kleur-1400.webp" loading="lazy" alt="Kleurrijk bruidsboeket met rozen en dahlia's in de hand van de bruid" class="h-full w-full object-cover" /></figure>
    </div>
  </section>

  <section id="brochure" class="grain relative mt-20 overflow-hidden bg-dark text-base scroll-mt-16">
    <div class="container-wide section-lg relative z-10 grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow-bone reveal">Start hier</p>
        <h2 class="reveal mt-6 type-display-lg text-base">Vraag de trouwbrochure aan</h2>
        <p class="reveal mt-7 max-w-md type-lead text-base/75">
          Ontvang de brochure met alle mogelijkheden voor jullie droomdag. Ieder bloemwerk wordt op maat samengesteld. Vul het formulier in en ik neem zo snel mogelijk contact op.
        </p>
      </div>

      <form id="brochure-form" class="reveal space-y-9 lg:col-span-6 lg:col-start-7" data-whatsapp={siteConfig.whatsappNumber}>
        <div class="space-y-2">
          <label for="brochure-name" class="eyebrow-bone">Jullie namen</label>
          <input type="text" id="brochure-name" required class="field-line field-line-light" placeholder="Bijv. Sophie & Thomas" />
        </div>
        <div class="grid gap-9 sm:grid-cols-2">
          <div class="space-y-2">
            <label for="brochure-date" class="eyebrow-bone">Trouwdatum</label>
            <input type="date" id="brochure-date" class="field-line field-line-light" />
          </div>
          <div class="space-y-2">
            <label for="brochure-location" class="eyebrow-bone">Locatie</label>
            <input type="text" id="brochure-location" class="field-line field-line-light" placeholder="Trouwlocatie" />
          </div>
        </div>
        <div class="space-y-2">
          <label for="brochure-contact" class="eyebrow-bone">Telefoonnummer of e-mail</label>
          <input type="text" id="brochure-contact" required class="field-line field-line-light" placeholder="06 ... of jullie@email.nl" />
        </div>
        <div class="space-y-2">
          <label for="brochure-notes" class="eyebrow-bone">Opmerkingen</label>
          <textarea id="brochure-notes" rows="3" class="field-line field-line-light resize-none" placeholder="Bijv. stijl, kleuren, aantal gasten"></textarea>
        </div>
        <button type="submit" class="btn-primary btn-light w-full sm:w-auto">
          <Icon name="ph:whatsapp-logo-light" class="h-5 w-5" />
          Brochure aanvragen via WhatsApp
        </button>
      </form>
    </div>

    <script>
      const form = document.getElementById('brochure-form') as HTMLFormElement | null;
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value;
        const name = val('brochure-name');
        const date = val('brochure-date');
        const location = val('brochure-location');
        const contact = val('brochure-contact');
        const notes = val('brochure-notes');

        const waNumber = form.dataset.whatsapp || '31614500402';
        let msg = `Hi Celine! Wij willen graag de trouwbrochure aanvragen.\n\n`;
        msg += `Namen: ${name}\n`;
        if (date) msg += `Trouwdatum: ${date}\n`;
        if (location) msg += `Locatie: ${location}\n`;
        msg += `Contact: ${contact}\n`;
        if (notes) msg += `Opmerkingen: ${notes}\n`;
        msg += `\nKunnen jullie de brochure sturen?`;

        window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`, '_blank');
      });
    </script>
  </section>

  <CtaSection />
</Layout>
