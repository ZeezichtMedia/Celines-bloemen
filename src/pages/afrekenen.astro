---
import Layout from '../layouts/Layout.astro';
import CheckoutForm from '../components/shop/CheckoutForm';
import { getPublicSettings, checkoutOpen, CHECKOUT_CLOSED_MESSAGE } from '../lib/settings';
import { siteConfig } from '../config';

const open = checkoutOpen(await getPublicSettings());
---

<Layout title="Afrekenen - Celine's bloemen" description="Rond je bestelling af en betaal veilig met iDEAL." noindex>
  <section class="page-top pb-10 md:pb-14">
    <div class="container-wide">
      <p class="eyebrow">Bijna klaar</p>
      <h1 class="mt-6 type-display-lg text-ink">Afrekenen</h1>
      <p class="mt-4 text-ink-muted">Vul je gegevens in en betaal veilig met iDEAL</p>
    </div>
  </section>
  <section class="pb-20 md:pb-28 px-4 md:px-6">
    {open ? <CheckoutForm client:load /> : (
      <div class="container-wide">
        <div class="max-w-xl rounded-[1.5rem] border border-line bg-white p-8">
          <p class="text-ink-soft">{CHECKOUT_CLOSED_MESSAGE}</p>
          <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="btn-primary mt-6">Stuur een WhatsApp</a>
        </div>
      </div>
    )}
  </section>
</Layout>
