---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';
---

<Layout title="Winkel Arnemuiden - Celine's bloemen" description="Kom langs in de winkel van Celine's Bloemen aan de Langstraat 81 in Arnemuiden. Verse bloemen, droogbloemen, kunstbloemen en decoratie.">
  
  <!-- Page Header -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 bg-sand-600 px-4 md:px-6 overflow-hidden relative">
    <div class="absolute inset-0 z-0 opacity-20">
      <img src="/images/winkel/winkel-interieur.png" loading="lazy" class="w-full h-full object-cover blur-sm" alt="Achtergrond winkel" />
    </div>
    <div class="relative z-10 max-w-4xl mx-auto text-center space-y-4 md:space-y-6">
      <span class="text-xs md:text-sm font-sans font-medium uppercase tracking-widest text-terra-600">Jouw lokale bloemist</span>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl text-forest leading-tight">Winkel Arnemuiden</h1>
      <p class="font-sans text-lg md:text-xl text-forest/70 font-light drop-shadow-sm max-w-xl mx-auto">
        Langstraat 81, Arnemuiden
      </p>
    </div>
  </section>

  <!-- Shop Content -->
  <section class="py-16 md:py-24 bg-white px-4 md:px-6">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-12 md:gap-16 items-center">
      
      <!-- Text -->
      <div class="w-full lg:w-1/2 space-y-6 md:space-y-8 font-sans font-light text-forest/80 leading-relaxed text-base md:text-lg">
        <h2 class="font-serif text-3xl sm:text-4xl text-forest stagger-reveal leading-tight">Kom langs in de winkel in Arnemuiden</h2>
        <p class="stagger-reveal">
          Hoihoi, welkom bij Celine's Bloemen. De winkel die sinds 2024 in de winkelstraat in Arnemuiden zit. Een winkel vol leuke decoratie, verse bloemen, droogbloemen en kunstbloemen.
        </p>
        <p class="stagger-reveal">
          Ben je op zoek naar een prachtig vers boeket, een leuk cadeau voor in je huis of wil je even wat inspiratie opdoen? Dan kun je altijd even binnenkomen bij Langstraat 81 in Arnemuiden.
        </p>

        <div class="p-8 bg-sand-500 rounded-sm stagger-reveal mt-8 shadow-sm">
          <h3 class="font-serif text-2xl text-forest mb-4">Neem je eigen vaas mee!</h3>
          <p class="text-forest/80">
            Heb je thuis een favoriete vaas staan die wel opgefleurd kan worden? Breng hem gerust mee naar de winkel. Zo maken we er een mooi vers boeket in, of een blijvend boeket met kunstbloemen. Precies zoals je wilt en passend bij jouw interieur.
          </p>
        </div>

        <div class="p-8 bg-forest text-white rounded-sm stagger-reveal mt-4 shadow-sm">
          <h3 class="font-serif text-2xl mb-4">Liever een boeket laten bezorgen?</h3>
          <p class="text-white/80 mb-6">
            Kun je niet langskomen? Geen probleem! Ik bezorg dagverse, handgebonden boeketten in de regio Walcheren. Kies je favoriete bos en laat hem bij je thuisbezorgen.
          </p>
          <a href="/bestellen" class="inline-block px-8 py-4 bg-white text-forest rounded-full font-bold tracking-widest uppercase text-xs hover:bg-sand-500 transition-colors shadow-lg">
            Bekijk de boeketten
          </a>
        </div>
      </div>

      <!-- Info & Image -->
      <div class="w-full lg:w-1/2 space-y-12 stagger-reveal">
        <div class="aspect-[4/3] rounded-xl overflow-hidden shadow-2xl relative">
          <div class="absolute inset-0 bg-sage-500/10 mix-blend-multiply z-10 transition-opacity duration-500 hover:opacity-0"></div>
          <img 
            src="/images/winkel/winkel-interieur.png"
            alt="Interieur van Celine's bloemenwinkel"
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bento-card rounded-2xl bg-white border border-sand-600/50 p-8 shadow-sm">
          <div>
            <h4 class="font-sans text-sm tracking-widest uppercase text-sage-500 font-medium mb-4">Adres</h4>
            <address class="not-italic text-forest">
              Langstraat 81<br/>
              4341 ED Arnemuiden<br/>
              Zeeland
            </address>
          </div>
          <div>
            <h4 class="font-sans text-sm tracking-widest uppercase text-sage-500 font-medium mb-4">Openingstijden</h4>
            <ul class="text-forest space-y-1">
              <li class="flex justify-between"><span>Dinsdag:</span> <span>09:00 - 17:00</span></li>
              <li class="flex justify-between"><span>Woensdag:</span> <span>09:00 - 17:00</span></li>
              <li class="flex justify-between"><span>Donderdag:</span> <span>09:00 - 17:00</span></li>
              <li class="flex justify-between"><span>Vrijdag:</span> <span>09:00 - 17:00</span></li>
              <li class="flex justify-between"><span>Zaterdag:</span> <span>09:00 - 12:30</span></li>
              <li class="flex justify-between text-forest/60"><span>Zondag & maandag:</span> <span>Gesloten</span></li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </section>

  <CtaSection />
</Layout>
