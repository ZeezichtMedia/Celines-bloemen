---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';

const onderwerpen = [
  { value: 'bruiloft', label: 'Bruiloft bloemen' },
  { value: 'droogbloemen', label: 'Droogbloemen bestellen' },
  { value: 'verhuur', label: 'Verhuur materiaal' },
  { value: 'abonnement', label: 'Bloemenabonnement' },
  { value: 'anders', label: 'Anders' },
];
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${siteConfig.address.street}, ${siteConfig.address.postalCode} ${siteConfig.address.city}`)}`;
---

<Layout
  title="Contact - Celine's bloemen"
  description="Neem contact met mij op voor jouw droogbloemen, verse bloemen of het ontwerpen van je bruidsboeket."
>
  <section class="page-top pb-20 md:pb-28">
    <div class="container-wide">
      <p class="eyebrow reveal">Kom langs of stuur een bericht</p>
      <h1 class="reveal mt-6 type-display-xl text-ink">Neem contact op</h1>

      <div class="mt-16 grid gap-16 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="reveal type-display-sm text-ink">Kom gezellig langs of stuur een berichtje</h2>
          <div class="reveal prose-celine mt-6">
            <p>Of je nu vragen hebt over een bloemenabonnement, stylingadvies nodig hebt voor jullie droomhuwelijk, of een boeket wil laten bezorgen op Walcheren of in de omgeving: ik denk graag met je mee.</p>
            <p>Je bent natuurlijk ook van harte welkom in de winkel aan de Langstraat 81 in Arnemuiden. Hier kun je onder het genot van een kopje koffie heerlijk rondsnuffelen in de verse bloemen of samen met mij jullie plannen bespreken.</p>
          </div>

          <ul class="reveal-stagger mt-12 border-t border-ink/12">
            <li class="flex flex-col items-start gap-2 border-b border-ink/12 py-5">
              <p class="eyebrow-ink">Telefoon of WhatsApp</p>
              <a href={`tel:${siteConfig.phone}`} class="inline-block font-display text-[1.7rem] text-ink transition hover:text-accent-600">{siteConfig.phoneDisplay}</a>
            </li>
            <li class="flex flex-col items-start gap-2 border-b border-ink/12 py-5">
              <p class="eyebrow-ink">E-mail</p>
              <a href={`mailto:${siteConfig.email}`} class="inline-block break-all font-display text-[1.7rem] text-ink transition hover:text-accent-600">{siteConfig.email}</a>
            </li>
            <li class="flex flex-col items-start gap-2 border-b border-ink/12 py-5">
              <p class="eyebrow-ink">Winkel</p>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-display text-[1.7rem] text-ink transition hover:text-accent-600">
                Langstraat 81, Arnemuiden <Icon name="ph:arrow-up-right-light" class="h-5 w-5" />
              </a>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          <div class="reveal rounded-[1.75rem] bg-base-2 p-7 sm:p-10 md:p-12">
            <h2 class="type-display-sm text-ink">Stuur een berichtje</h2>
            <form id="contact-form" class="mt-10 space-y-9">
              <div class="grid gap-9 sm:grid-cols-2">
                <div class="space-y-2">
                  <label for="contact-name" class="eyebrow-ink">Jouw naam</label>
                  <input type="text" id="contact-name" name="name" required class="field-line" placeholder="Bijv. Sofie Jansen" />
                </div>
                <div class="space-y-2">
                  <label for="contact-email" class="eyebrow-ink">E-mailadres</label>
                  <input type="email" id="contact-email" name="email" required class="field-line" placeholder="jouw@email.nl" />
                </div>
              </div>

              <fieldset class="space-y-4">
                <legend class="eyebrow-ink">Onderwerp</legend>
                <div class="flex flex-wrap gap-2">
                  {onderwerpen.map((o, i) => (
                    <label class="opt px-4 py-2.5 text-[0.9rem]">
                      <input type="radio" name="subject" value={o.value} data-label={o.label} class="sr-only" checked={i === 0} />
                      {o.label}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="space-y-2">
                <label for="contact-message" class="eyebrow-ink">Jouw bericht</label>
                <textarea id="contact-message" name="message" rows="4" required class="field-line resize-none" placeholder="Typ hier je bericht"></textarea>
              </div>

              <button type="submit" class="btn-primary w-full sm:w-auto">
                <Icon name="ph:whatsapp-logo-light" class="h-5 w-5" />
                Verstuur via WhatsApp
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ whatsappNumber: siteConfig.whatsappNumber }}>
    (() => {
      const form = document.getElementById("contact-form");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const name = document.getElementById("contact-name").value;
        const email = document.getElementById("contact-email").value;
        const subject = form.querySelector('input[name="subject"]:checked');
        const subjectText = subject ? subject.dataset.label : "Anders";
        const message = document.getElementById("contact-message").value;

        let msg = `Hi Celine! Ik stuur je een berichtje via de website.\n\n`;
        msg += `Naam: ${name}\n`;
        msg += `E-mail: ${email}\n`;
        msg += `Onderwerp: ${subjectText}\n\n`;
        msg += `Bericht:\n${message}`;

        window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`, "_blank");
      });
    })();
  </script>
</Layout>
