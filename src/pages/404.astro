---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden - Celine's bloemen" description="Deze pagina bestaat niet.">
  <section class="page-top flex min-h-[80svh] items-center pb-20">
    <div class="container-narrow">
      <p class="eyebrow">Pagina niet gevonden</p>
      <h1 class="mt-8 type-display-xl text-ink">Deze bloem staat hier niet.</h1>
      <p class="mt-6 max-w-md type-lead text-ink-muted">
        Sorry, deze pagina bestaat niet of is verplaatst. Misschien vind je wat je zoekt via de links hieronder.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Terug naar home</a>
        <a href="/bestellen" class="btn-ghost">Bekijk boeketten</a>
      </div>
    </div>
  </section>
</Layout>
