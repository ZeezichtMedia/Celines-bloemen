---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';
---

<Layout title="Bloemen Abonnement - Celine's bloemen" description="Een vers bloemenabonnement in Zeeland. Laat de seizoenen spreken in jouw interieur, wekelijks of maandelijks bezorgd.">

  <!-- Hero Section with Image -->
  <section class="pt-40 pb-20 bg-sand-600 px-6 overflow-hidden relative">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16">
      <div class="lg:w-1/2 space-y-8 text-center lg:text-left">
        <span class="text-sm font-sans font-medium uppercase tracking-widest text-terra-600">Nooit meer een lege vaas</span>
        <h1 class="font-serif text-4xl md:text-7xl lg:text-8xl text-forest leading-[0.9]">Seizoensgeluk op Herhaling</h1>
        <p class="font-sans text-xl text-forest/70 font-light max-w-xl stagger-reveal">
          Haal de verstilling van het atelier in huis. Met een bloemenabonnement geniet je op jouw tempo van de allermooiste seizoensbloemen, zonder dat je erover na hoeft te denken.
        </p>
      </div>
      <div class="lg:w-1/2 relative">
        <div class="aspect-square rounded-full overflow-hidden shadow-2xl border-8 border-white/50 relative z-10 stagger-reveal">
          <img 
            src="/images/abonnementen/minimalist-bouquet.png" 
            alt="Minimalistisch wit boeket op witte achtergrond" 
            class="w-full h-full object-cover"
          />
        </div>
        <!-- Decorative blob -->
        <div class="absolute -top-10 -right-10 w-64 h-64 bg-sage-500/20 rounded-full blur-3xl -z-10"></div>
      </div>
    </div>
  </section>

  <!-- Hoe het werkt -->
  <section class="py-24 bg-white px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20 space-y-4">
        <h2 class="font-serif text-4xl md:text-5xl text-forest italic">Hoe het werkt</h2>
        <div class="h-1 w-20 bg-terra-400 mx-auto rounded-full"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-16 text-center">
        <div class="space-y-4 stagger-reveal">
          <div class="w-16 h-16 bg-sand-500 rounded-full flex items-center justify-center mx-auto text-forest font-serif text-2xl font-bold">1</div>
          <h3 class="font-serif text-2xl text-forest">Kies je Maat</h3>
          <p class="font-sans font-light text-forest/70">Van een subtiel boeketje tot een weelderig pronkstuk; kies het formaat dat bij jouw ruimte past.</p>
        </div>
        <div class="space-y-4 stagger-reveal">
          <div class="w-16 h-16 bg-sand-500 rounded-full flex items-center justify-center mx-auto text-forest font-serif text-2xl font-bold">2</div>
          <h3 class="font-serif text-2xl text-forest">Bepaal de Frequentie</h3>
          <p class="font-sans font-light text-forest/70">Wekelijks, tweewekelijks of één keer per maand. Jij bepaalt hoe vaak we sfeer komen brengen.</p>
        </div>
        <div class="space-y-4 stagger-reveal">
          <div class="w-16 h-16 bg-sand-500 rounded-full flex items-center justify-center mx-auto text-forest font-serif text-2xl font-bold">3</div>
          <h3 class="font-serif text-2xl text-forest">Geniet van Versheid</h3>
          <p class="font-sans font-light text-forest/70">Wij bezorgen de bloemen met zorg aan de deur, zodat jij alleen nog maar de vaas hoeft neer te zetten.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="py-24 bg-sand-500/30 px-6 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <!-- Small -->
      <div class="p-10 bg-white border border-sand-600/30 rounded-3xl flex flex-col stagger-reveal shadow-sm hover:shadow-xl transition-all duration-500 group">
        <h3 class="font-serif text-3xl text-forest mb-2 group-hover:text-terra-600 transition-colors">Small</h3>
        <p class="font-light text-forest/70 mb-8 min-h-[60px]">Een bescheiden, verfijnd boeketje. Ideaal voor op het keukeneiland of als subtiel accent in huis.</p>
        <div class="text-4xl font-serif text-sage-600 mb-8 border-b border-sand-500 pb-8">€ 17,50 <span class="text-sm font-sans text-forest/50">/ keer</span></div>
        <ul class="space-y-4 font-light text-forest/80 mb-auto italic">
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Dagverse selectie</li>
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Verrassend kleurenpalet</li>
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Inclusief lokale bezorging</li>
        </ul>
        <button class="mt-12 w-full py-5 bg-forest text-white text-xs tracking-widest uppercase hover:bg-terra-600 transition-all duration-300 rounded-full font-bold shadow-lg">Kies dit plan</button>
      </div>

      <!-- Medium -->
      <div class="p-10 border-2 border-sage-500 rounded-3xl flex flex-col shadow-2xl transform lg:-translate-y-8 bg-white stagger-reveal relative group">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-sage-500 text-white text-xs font-bold tracking-widest uppercase px-6 py-2 rounded-full">Favoriet</div>
        <h3 class="font-serif text-3xl text-forest mb-2 group-hover:text-terra-600 transition-colors">Medium</h3>
        <p class="font-light text-forest/70 mb-8 min-h-[60px]">Een rijk boeket met karaktervolle seizoensbloemen. De perfecte blikvanger voor op de eettafel.</p>
        <div class="text-4xl font-serif text-sage-600 mb-8 border-b border-sand-500 pb-8">€ 27,50 <span class="text-sm font-sans text-forest/50">/ keer</span></div>
        <ul class="space-y-4 font-light text-forest/80 mb-auto italic">
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Luxe seizoensstelen</li>
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Exclusieve combinaties</li>
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Inclusief lokale bezorging</li>
        </ul>
        <button class="mt-12 w-full py-6 bg-sage-500 text-white text-xs tracking-widest uppercase hover:bg-forest transition-all duration-300 rounded-full font-bold shadow-lg">Deel in het plezier</button>
      </div>

      <!-- Large -->
      <div class="p-10 bg-white border border-sand-600/30 rounded-3xl flex flex-col stagger-reveal shadow-sm hover:shadow-xl transition-all duration-500 group">
        <h3 class="font-serif text-3xl text-forest mb-2 group-hover:text-terra-600 transition-colors">Large</h3>
        <p class="font-light text-forest/70 mb-8 min-h-[60px]">Een extravagant pronkstuk vol diepgang en textuur. Voor wie écht wil uitpakken in het interieur.</p>
        <div class="text-4xl font-serif text-sage-600 mb-8 border-b border-sand-500 pb-8">€ 39,50 <span class="text-sm font-sans text-forest/50">/ keer</span></div>
        <ul class="space-y-4 font-light text-forest/80 mb-auto italic">
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Maximaal volume & luxe</li>
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Robuuste eye-catchers</li>
          <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg> Inclusief lokale bezorging</li>
        </ul>
        <button class="mt-12 w-full py-5 bg-forest text-white text-xs tracking-widest uppercase hover:bg-terra-600 transition-all duration-300 rounded-full font-bold shadow-lg">Kies dit plan</button>
      </div>

    </div>
  </section>

  <!-- Zakelijk Section -->
  <section class="py-24 bg-white px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-16 rounded-3xl bg-forest p-12 lg:p-20 text-white overflow-hidden relative">
      <div class="absolute inset-0 opacity-10 pointer-events-none">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <circle cx="90" cy="10" r="30" fill="white" />
        </svg>
      </div>
      <div class="md:w-2/3 space-y-8 relative z-10">
        <h2 class="font-serif text-4xl lg:text-5xl italic">Zakelijk Bloemwerk</h2>
        <p class="font-sans font-light text-white/80 text-lg leading-relaxed">
          Wil je jouw kantoor, winkel of horecagelegenheid voorzien van een frisse, natuurlijke uitstraling? Ook voor bedrijven bieden we flexibele abonnementen aan. Van een eyecatcher op de balie tot sfeervolle tafeldecoratie; we denken graag mee over een floral concept dat bij jouw merk past.
        </p>
        <a href="/contact" class="inline-block px-10 py-5 bg-white text-forest rounded-full font-bold tracking-widest uppercase text-xs hover:bg-sand-500 transition-colors shadow-xl">Contact opnemen</a>
      </div>
    </div>
  </section>

  <CtaSection />
</Layout>
