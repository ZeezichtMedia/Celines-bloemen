---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';
import SubscriptionForm from '../components/shop/SubscriptionForm';
import { PLANS, FRESH_FREQUENCIES, formatEuro, planLabel } from '../lib/plans';

const freshPlans = PLANS.filter((p) => p.type === 'fresh');
const artificialPlans = PLANS.filter((p) => p.type === 'artificial');
const CHECK = 'M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z';
---

<Layout title="Bloemen Abonnement - Celine's bloemen" description="Een vers of kunstbloemen abonnement in Zeeland. Laat de seizoenen spreken in jouw interieur.">

  <!-- Hero Section -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-20 bg-sand-600 px-4 md:px-6 overflow-hidden relative">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-10 md:gap-16">
      <div class="lg:w-1/2 space-y-6 md:space-y-8 text-center lg:text-left">
        <span class="text-xs md:text-sm font-sans font-medium uppercase tracking-widest text-terra-600">Nooit meer een lege vaas</span>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-forest leading-[1.1] md:leading-[0.9]">Abonnement met seizoensbloemen</h1>
        <p class="font-sans text-lg md:text-xl text-forest/70 font-light max-w-xl lg:mx-0 mx-auto stagger-reveal">
          Krijg elke twee weken, elke drie weken of maandelijks jouw boeket in huis. Met een bloemenabonnement geniet je altijd van de mooiste seizoensbloemen, zonder dat je er achteraan hoeft te gaan.
        </p>
      </div>
      <div class="lg:w-1/2 relative">
        <div class="aspect-square rounded-full overflow-hidden shadow-2xl border-8 border-white/50 relative z-10 stagger-reveal">
          <img src="/images/abonnementen/minimalist-bouquet.png" alt="Minimalistisch wit boeket op witte achtergrond" loading="lazy" class="w-full h-full object-cover" />
        </div>
        <div class="absolute -top-10 -right-10 w-64 h-64 bg-sage-500/20 rounded-full blur-3xl -z-10"></div>
      </div>
    </div>
  </section>

  <!-- Hoe het werkt -->
  <section class="py-16 md:py-24 bg-white px-4 md:px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 md:mb-20 space-y-4">
        <h2 class="font-serif text-4xl md:text-5xl text-forest italic leading-tight">Hoe het werkt</h2>
        <div class="h-1 w-20 bg-terra-400 mx-auto rounded-full"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16 text-center">
        <div class="space-y-4 stagger-reveal">
          <div class="w-16 h-16 bg-sand-500 rounded-full flex items-center justify-center mx-auto text-forest font-serif text-2xl font-bold">1</div>
          <h3 class="font-serif text-2xl text-forest">Kies je boeket</h3>
          <p class="font-sans font-light text-forest/70">Small, medium of large, en hoe vaak je het thuis wilt hebben.</p>
        </div>
        <div class="space-y-4 stagger-reveal">
          <div class="w-16 h-16 bg-sand-500 rounded-full flex items-center justify-center mx-auto text-forest font-serif text-2xl font-bold">2</div>
          <h3 class="font-serif text-2xl text-forest">Betaal met iDEAL</h3>
          <p class="font-sans font-light text-forest/70">Veilig betalen via Mollie. Na de eerste betaling wordt automatisch een incasso aangemaakt.</p>
        </div>
        <div class="space-y-4 stagger-reveal">
          <div class="w-16 h-16 bg-sand-500 rounded-full flex items-center justify-center mx-auto text-forest font-serif text-2xl font-bold">3</div>
          <h3 class="font-serif text-2xl text-forest">Geniet van het boeket</h3>
          <p class="font-sans font-light text-forest/70">Ik bezorg de bloemen met zorg aan de deur. Pauzeren of stoppen kan altijd.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Verse Bloemen Pricing Cards -->
  <section class="py-16 md:py-24 bg-sand-500/30 px-4 md:px-6 overflow-hidden">
    <div class="max-w-4xl mx-auto text-center mb-12 space-y-4 stagger-reveal">
      <span class="text-terra-600 font-sans text-xs md:text-sm uppercase tracking-widest font-bold">Vers uit de winkel</span>
      <h2 class="font-serif text-3xl md:text-5xl text-forest italic leading-tight">Kies je boeket</h2>
      <p class="font-sans text-forest/70 font-light text-base md:text-lg max-w-xl mx-auto">Dagverse seizoensbloemen, bezorgd in Arnemuiden, Middelburg, Vlissingen en omgeving. Prijzen per levering, inclusief btw.</p>
    </div>

    <!-- Hoe vaak -->
    <div class="max-w-3xl mx-auto mb-12 md:mb-16 text-center stagger-reveal">
      <h3 class="font-sans text-xs uppercase tracking-[0.25em] text-forest/40 font-bold mb-5">Hoe vaak wil je bloemen?</h3>
      <div class="inline-flex flex-col sm:flex-row gap-2 p-2 bg-white rounded-2xl sm:rounded-full shadow-sm border border-sand-600/30" role="radiogroup" aria-label="Kies hoe vaak je een boeket wilt ontvangen">
        {FRESH_FREQUENCIES.map((f, i) => (
          <button
            type="button"
            class={`freq-btn px-7 py-3.5 rounded-full text-xs uppercase tracking-widest font-bold transition-all duration-300 ${i === 0 ? 'bg-forest text-white' : 'text-forest/60 hover:text-forest'}`}
            data-frequency={f.value}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
    </div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12">
      {freshPlans.map((plan) => (
        <div class={plan.featured
          ? 'p-10 border-2 border-sage-500 rounded-3xl flex flex-col shadow-2xl transform lg:-translate-y-8 bg-white stagger-reveal relative group'
          : 'p-10 bg-white border border-sand-600/30 rounded-3xl flex flex-col stagger-reveal shadow-sm hover:shadow-xl transition-all duration-500 group'}>
          {plan.featured && <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-sage-500 text-white text-xs font-bold tracking-widest uppercase px-6 py-2 rounded-full">Favoriet</div>}
          <h3 class="font-serif text-3xl text-forest mb-2 group-hover:text-terra-600 transition-colors">{plan.size}</h3>
          <p class="font-light text-forest/70 mb-8 min-h-[84px]">{plan.description}</p>
          <div class="text-4xl font-serif text-sage-600 mb-8 border-b border-sand-500 pb-8">{formatEuro(plan.price)} <span class="text-sm font-sans text-forest/50">/ keer</span></div>
          <ul class="space-y-4 font-light text-forest/80 mb-auto">
            {plan.bullets.map((b) => (
              <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d={CHECK}></path></svg> {b}</li>
            ))}
          </ul>
          <button
            type="button"
            class={`sub-btn mt-12 w-full ${plan.featured ? 'py-6 bg-sage-500 hover:bg-forest' : 'py-5 bg-forest hover:bg-terra-600'} text-white text-xs tracking-widest uppercase transition-all duration-300 rounded-full font-bold shadow-lg`}
            data-type={plan.type}
            data-size={plan.size}
            data-frequency={plan.defaultFrequency}
            data-price={formatEuro(plan.price)}
            data-label={planLabel(plan)}
          >Kies dit boeket</button>
        </div>
      ))}
    </div>

    <!-- Vaas -->
    <div class="max-w-3xl mx-auto mt-12 md:mt-16 bg-white rounded-3xl p-8 md:p-10 shadow-sm text-center stagger-reveal">
      <h3 class="font-serif text-2xl md:text-3xl text-forest mb-3">Liever mét vaas?</h3>
      <p class="font-sans font-light text-forest/70 leading-relaxed max-w-xl mx-auto">
        Vink bij het bestellen aan dat je het boeket in een vaas wilt ontvangen. Bij de volgende levering ruilen we de vaas gewoon weer om, zodat je nooit zonder zit.
      </p>
    </div>
  </section>

  <!-- Kunstbloemen Abonnement -->
  <section class="py-16 md:py-24 bg-white px-4 md:px-6">
    <div class="max-w-4xl mx-auto text-center mb-12 space-y-4 stagger-reveal">
      <span class="text-terra-600 font-sans text-xs md:text-sm uppercase tracking-widest font-bold">Duurzaam & onderhoudsvrij</span>
      <h2 class="font-serif text-3xl md:text-5xl text-forest italic leading-tight">Kunstbloemen Abonnement</h2>
      <p class="font-sans text-forest/70 font-light text-base md:text-lg max-w-xl mx-auto">Elke periode een nieuw, zorgvuldig samengesteld kunstbloemen arrangement. Altijd fris, zonder onderhoud.</p>
    </div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12">
      {artificialPlans.map((plan) => (
        <div class={plan.featured
          ? 'p-10 border-2 border-sage-500 rounded-3xl flex flex-col shadow-2xl transform lg:-translate-y-8 bg-white stagger-reveal relative group'
          : 'p-10 bg-sand-500/30 border border-sand-600/30 rounded-3xl flex flex-col stagger-reveal shadow-sm hover:shadow-xl transition-all duration-500 group'}>
          {plan.featured && <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-sage-500 text-white text-xs font-bold tracking-widest uppercase px-6 py-2 rounded-full">Favoriet</div>}
          <h3 class="font-serif text-3xl text-forest mb-2 group-hover:text-terra-600 transition-colors">{plan.size}</h3>
          <p class="font-light text-forest/70 mb-8 min-h-[84px]">{plan.description}</p>
          <div class="text-4xl font-serif text-sage-600 mb-8 border-b border-sand-500 pb-8">{formatEuro(plan.price)} <span class="text-sm font-sans text-forest/50">/ keer</span></div>
          <ul class="space-y-4 font-light text-forest/80 mb-auto">
            {plan.bullets.map((b) => (
              <li class="flex items-center gap-3"><svg class="w-4 h-4 text-terra-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d={CHECK}></path></svg> {b}</li>
            ))}
          </ul>
          <button
            type="button"
            class={`sub-btn mt-12 w-full ${plan.featured ? 'py-6 bg-sage-500 hover:bg-forest' : 'py-5 bg-forest hover:bg-terra-600'} text-white text-xs tracking-widest uppercase transition-all duration-300 rounded-full font-bold shadow-lg`}
            data-type={plan.type}
            data-size={plan.size}
            data-frequency={plan.defaultFrequency}
            data-price={formatEuro(plan.price)}
            data-label={planLabel(plan)}
          >Kies dit plan</button>
        </div>
      ))}
    </div>
  </section>

  <!-- Zakelijk Section -->
  <section class="py-16 md:py-24 bg-sand-500/30 px-4 md:px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-10 md:gap-16 rounded-3xl bg-forest p-8 md:p-12 lg:p-20 text-white overflow-hidden relative">
      <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <circle cx="90" cy="10" r="30" fill="white" />
        </svg>
      </div>
      <div class="md:w-2/3 space-y-6 md:space-y-8 relative z-10">
        <span class="text-xs md:text-sm font-sans font-bold uppercase tracking-widest text-sand-500">Voor bedrijven</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl italic leading-tight">Zakelijk Bloemwerk</h2>
        <p class="font-sans font-light text-white/80 text-lg leading-relaxed">
          Wil je jouw kantoor, winkel of horecagelegenheid voorzien van een frisse, natuurlijke uitstraling? Ik bied flexibele zakelijke abonnementen aan met zowel verse als kunstbloemen. Van een eyecatcher op de balie tot sfeervolle tafeldecoratie: ik denk graag mee over een concept dat bij jouw bedrijf past.
        </p>
        <div class="flex flex-wrap gap-4">
          <span class="inline-block px-4 py-2 bg-white/10 rounded-full text-xs uppercase tracking-widest font-bold text-sand-500">Verse bloemen</span>
          <span class="inline-block px-4 py-2 bg-white/10 rounded-full text-xs uppercase tracking-widest font-bold text-sand-500">Kunstbloemen</span>
          <span class="inline-block px-4 py-2 bg-white/10 rounded-full text-xs uppercase tracking-widest font-bold text-sand-500">Op maat</span>
        </div>
        <a href="/contact" class="inline-block px-10 py-5 bg-white text-forest rounded-full font-bold tracking-widest uppercase text-xs hover:bg-sand-500 transition-colors shadow-xl">Neem contact op</a>
      </div>
    </div>
  </section>

  <!-- Subscription Form (React, renders as portal) -->
  <SubscriptionForm client:load />

  <CtaSection />

  <!-- Wire up buttons to open the subscription form -->
  <script>
    const initSubButtons = () => {
      const controller = new AbortController();
      const { signal } = controller;
      const marker = document.querySelector('.sub-btn');
      if (!marker) return;
      const prev = (marker as any).__subCleanup;
      if (prev) prev();
      (marker as any).__subCleanup = () => controller.abort();

      // Frequentiekeuze (alleen voor verse bloemen)
      const freqBtns = document.querySelectorAll('.freq-btn');
      freqBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const freq = (btn as HTMLElement).dataset.frequency!;
          freqBtns.forEach(b => {
            const active = (b as HTMLElement).dataset.frequency === freq;
            b.classList.toggle('bg-forest', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('text-forest/60', !active);
            b.classList.toggle('hover:text-forest', !active);
            b.setAttribute('aria-pressed', String(active));
          });
          document.querySelectorAll('.sub-btn[data-type="fresh"]').forEach(b => {
            (b as HTMLElement).dataset.frequency = freq;
          });
        }, { signal });
      });

      document.querySelectorAll('.sub-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const el = btn as HTMLElement;
          const plan = {
            type: el.dataset.type,
            size: el.dataset.size,
            frequency: el.dataset.frequency,
            price: el.dataset.price,
            label: el.dataset.label,
          };
          if ((window as any).__openSubscription) {
            (window as any).__openSubscription(plan);
          }
        }, { signal });
      });
    };

    initSubButtons();
    document.addEventListener('astro:page-load', initSubButtons);
  </script>
</Layout>
