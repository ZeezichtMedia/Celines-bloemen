---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/home/CtaSection.astro';
import SubscriptionForm from '../components/shop/SubscriptionForm';
import PlanCards from '../components/shop/PlanCards.astro';
import { PLANS, FRESH_FREQUENCIES } from '../lib/plans';
import { getPublicSettings, checkoutOpen } from '../lib/settings';

const open = checkoutOpen(await getPublicSettings());

const freshPlans = PLANS.filter((p) => p.type === 'fresh');
const artificialPlans = PLANS.filter((p) => p.type === 'artificial');
---

<Layout title="Bloemen Abonnement - Celine's bloemen" description="Een vers of kunstbloemen abonnement in Zeeland. Laat de seizoenen spreken in jouw interieur.">

  <section class="page-top pb-16 md:pb-24">
    <div class="container-wide grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow reveal">Nooit meer een lege vaas</p>
        <h1 class="reveal mt-6 type-display-xl text-ink">Abonnement met seizoensbloemen</h1>
        <p class="reveal mt-8 max-w-xl type-lead text-ink-muted">
          Krijg elke twee weken, elke drie weken of maandelijks jouw boeket in huis. Met een bloemenabonnement geniet je altijd van de mooiste seizoensbloemen, zonder dat je er achteraan hoeft te gaan.
        </p>
        <a href="#kies" class="reveal btn-primary mt-10">Kies je boeket <Icon name="ph:arrow-down-light" class="h-4 w-4" /></a>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <div class="relative mx-auto max-w-[420px]">
          <div class="arch-line reveal"></div>
          <figure class="reveal-image arch aspect-[3/4] bg-base-2">
            <img src="/images/opt/abonnement-boeket-800.webp" alt="Een wit boeket met ranonkels in een glazen vaas" width="640" height="640" fetchpriority="high" class="h-full w-full object-cover" />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-base-2">
    <div class="container-wide">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow reveal">Zo werkt het</p>
          <h2 class="reveal mt-6 type-display-md text-ink">Hoe het werkt</h2>
        </div>
      </div>
      <div class="reveal-stagger mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
        <article class="border-t border-ink/15 pt-6">
          <p class="text-xs tabular-nums text-accent-600">01</p>
          <h3 class="mt-4 font-display text-[1.6rem] leading-tight text-ink">Kies je boeket</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">Small, medium of large, en hoe vaak je het thuis wilt hebben.</p>
        </article>
        <article class="border-t border-ink/15 pt-6">
          <p class="text-xs tabular-nums text-accent-600">02</p>
          {open ? (
            <>
              <h3 class="mt-4 font-display text-[1.6rem] leading-tight text-ink">Betaal met iDEAL</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">Veilig betalen via Mollie. Na de eerste betaling wordt automatisch een incasso aangemaakt.</p>
            </>
          ) : (
            <>
              <h3 class="mt-4 font-display text-[1.6rem] leading-tight text-ink">Stuur een berichtje</h3>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">Vraag je abonnement aan via WhatsApp. Dan spreken we samen de eerste levering en de betaling af.</p>
            </>
          )}
        </article>
        <article class="border-t border-ink/15 pt-6">
          <p class="text-xs tabular-nums text-accent-600">03</p>
          <h3 class="mt-4 font-display text-[1.6rem] leading-tight text-ink">Geniet van het boeket</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-muted">Ik bezorg de bloemen met zorg aan de deur. Pauzeren of stoppen kan altijd.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="kies" class="section-lg scroll-mt-24">
    <div class="container-wide">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow reveal">Vers uit de winkel</p>
          <h2 class="reveal mt-6 type-display-lg text-ink">Kies je boeket</h2>
        </div>
        <p class="reveal type-lead text-ink-muted lg:col-span-5 lg:col-start-8">Dagverse seizoensbloemen, bezorgd in Arnemuiden, Middelburg, Vlissingen en omgeving. Prijzen per levering, inclusief btw.</p>
      </div>

      <div class="reveal mt-12 flex flex-col gap-4 sm:flex-row sm:items-center">
        <p class="eyebrow-ink">Hoe vaak wil je bloemen?</p>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Kies hoe vaak je een boeket wilt ontvangen">
          {FRESH_FREQUENCIES.map((f, i) => (
            <button type="button" class="freq-btn opt px-5 py-2.5 text-[0.9rem]" data-frequency={f.value} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
      </div>

      <div class="mt-10">
        <PlanCards plans={freshPlans} cta={open ? "Kies dit boeket" : "Aanvragen via WhatsApp"} />
      </div>

      <div class="reveal mt-10 grid gap-4 rounded-[1.5rem] bg-base-2 p-8 md:grid-cols-12 md:items-center md:p-10">
        <h3 class="font-display text-[1.9rem] leading-tight text-ink md:col-span-4">Liever mét vaas?</h3>
        <p class="leading-relaxed text-ink-muted md:col-span-7 md:col-start-6">
          Vink bij het bestellen aan dat je het boeket in een vaas wilt ontvangen. Bij de volgende levering ruilen we de vaas gewoon weer om, zodat je nooit zonder zit.
        </p>
      </div>
    </div>
  </section>

  <section class="section-lg border-t border-line">
    <div class="container-wide">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow reveal">De trend van nu</p>
          <h2 class="reveal mt-6 type-display-lg text-ink">Kunstbloemen abonnement</h2>
        </div>
        <p class="reveal leading-relaxed text-ink-muted lg:col-span-5 lg:col-start-8">
          Kunstbloemen zijn de trend van nu. Wil je toch de afwisseling houden van verschillende boeketten in huis of op kantoor? Kies dan voor een kunstbloemen abonnement. Maandelijks, per half jaar of per jaar kun je kiezen voor een boeket. Het boeket wordt in een vaas geleverd, dus je hebt er geen omkijken naar.
        </p>
      </div>
      <div class="mt-14">
        <PlanCards plans={artificialPlans} cta={open ? "Kies dit plan" : "Aanvragen via WhatsApp"} />
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-12">
        <h3 class="reveal font-display text-[1.9rem] text-ink lg:col-span-4">Goed om te weten</h3>
        <ul class="reveal-stagger space-y-4 text-ink-muted lg:col-span-7 lg:col-start-6">
          <li class="flex gap-3 border-t border-ink/10 pt-4"><Icon name="ph:flower-light" class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" /> Het boeket komt in een rookvrij huis te staan.</li>
          <li class="flex gap-3 border-t border-ink/10 pt-4"><Icon name="ph:flower-light" class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" /> Het boeket blijft intact, zodat ik het de volgende keer weer kan omruilen.</li>
          <li class="flex gap-3 border-t border-ink/10 pt-4"><Icon name="ph:flower-light" class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" /> Is de vaas beschadigd? Dan moet ik daar helaas een bedrag voor rekenen.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="grain relative overflow-hidden bg-dark text-base">
    <div class="container-wide section relative z-10 grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <figure class="reveal-image aspect-[4/5] overflow-hidden rounded-[1.5rem]">
          <img src="/images/opt/trouwtafel-lavendel-800.webp" alt="Gedekte tafel met verse bloemen in een glazen vaas" loading="lazy" class="h-full w-full object-cover" />
        </figure>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="eyebrow-bone reveal">Voor bedrijven</p>
        <h2 class="reveal mt-6 type-display-lg text-base">Zakelijk bloemwerk</h2>
        <p class="reveal mt-7 type-lead text-base/75">
          Wil je jouw kantoor, winkel of horecagelegenheid voorzien van een frisse, natuurlijke uitstraling? Ik bied flexibele zakelijke abonnementen aan met zowel verse als kunstbloemen. Van een eyecatcher op de balie tot sfeervolle tafeldecoratie: ik denk graag mee over een concept dat bij jouw bedrijf past.
        </p>
        <p class="reveal mt-8 text-sm uppercase tracking-[0.18em] text-accent-300">Verse bloemen · Kunstbloemen · Op maat</p>
        <a href="/contact" class="reveal btn-primary btn-light mt-10">Neem contact op <Icon name="ph:arrow-right-light" class="ico h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <SubscriptionForm client:load />

  <CtaSection />

  <!-- Wire up buttons to open the subscription form -->
  <script>

    // Online afrekenen staat uit (beheer > Instellingen): bestellen gaat dan via WhatsApp
    const viaWhatsApp = (tekst: string) => {
      if (document.body.dataset.checkout !== 'closed') return false;
      window.open(`https://wa.me/${document.body.dataset.wa}?text=${encodeURIComponent(tekst)}`, '_blank');
      return true;
    };

    const initSubButtons = () => {
      const controller = new AbortController();
      const { signal } = controller;
      const marker = document.querySelector('.sub-btn');
      if (!marker) return;
      const prev = (marker as any).__subCleanup;
      if (prev) prev();
      (marker as any).__subCleanup = () => controller.abort();

      // Frequentiekeuze (alleen voor verse bloemen)
      const freqBtns = document.querySelectorAll('.freq-btn');
      freqBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const freq = (btn as HTMLElement).dataset.frequency!;
          freqBtns.forEach(b => {
            b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.frequency === freq));
          });
          document.querySelectorAll('.sub-btn[data-type="fresh"]').forEach(b => {
            (b as HTMLElement).dataset.frequency = freq;
          });
        }, { signal });
      });

      document.querySelectorAll('.sub-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const el = btn as HTMLElement;
          const plan = {
            type: el.dataset.type,
            size: el.dataset.size,
            frequency: el.dataset.frequency,
            price: el.dataset.price,
            label: el.dataset.label,
          };
          const freqLabel = (document.querySelector('.freq-btn[aria-pressed="true"]') as HTMLElement | null)?.textContent?.trim().toLowerCase();
          if (viaWhatsApp(`Hoi Celine! Ik heb interesse in het abonnement ${plan.label}${plan.type === 'fresh' && freqLabel ? `, ${freqLabel}` : ''}.`)) return;
          if ((window as any).__openSubscription) {
            (window as any).__openSubscription(plan);
          }
        }, { signal });
      });
    };

    initSubButtons();
    document.addEventListener('astro:page-load', initSubButtons);
  </script>
</Layout>
