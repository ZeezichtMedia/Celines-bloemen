<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>Image Manager - Celines Bloemen</title>
    <style>
        :root {
            --primary: #d4a373;
            --secondary: #faedcd;
            --bg: #fefae0;
            --text: #606c38;
            --dark: #283618;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            color: var(--dark);
            margin: 0;
            padding: 2rem;
        }
        h1 { text-align: center; color: var(--dark); }
        .page-group {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        .page-url {
            font-weight: bold;
            font-size: 1.2rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--secondary);
            color: var(--text);
        }
        .image-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1.5rem;
        }
        .image-card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            transition: transform 0.2s;
        }
        .image-card:hover { transform: translateY(-2px); box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .image-card.skipped { opacity: 0.5; background: #f0f0f0; }
        .image-preview {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 4px;
            background: #eee;
        }
        input[type="text"] {
            padding: 0.5rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            width: calc(100% - 1rem);
        }
        .controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
        }
        .export-box {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: var(--dark);
            color: white;
            padding: 1rem 2rem;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            font-weight: bold;
            z-index: 100;
        }
        .export-box:hover { background: var(--text); }
        .counter {
            text-align: center;
            font-size: 0.8rem;
            color: #888;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <h1>Image Manager (Full Version)</h1>
    <p style="text-align: center;">Geef de afbeeldingen een naam en kies welke je wilt opslaan.</p>
    <div class="counter text-center">Totaal aantal afbeeldingen: {scrapedData.reduce((acc, curr) => acc + curr.images.length, 0)}</div>

    <div id="container">
        {scrapedData.map((page, pIdx) => (
            <div class="page-group" data-url={page.url}>
                <div class="page-url">Pagina: {page.url} ({page.images.length} afbeeldingen)</div>
                <div class="image-grid">
                    {page.images.map((img, iIdx) => (
                        <div class="image-card" id={`card-${pIdx}-${iIdx}`}>
                            <img src={img} class="image-preview" loading="lazy" />
                            <input 
                                type="text" 
                                placeholder="Nieuwe bestandsnaam..." 
                                class="name-input" 
                                data-original={img}
                                data-page={page.url}
                                value={img.split('/').pop().split('.')[0].substring(0, 30)}
                            />
                            <div class="controls">
                                <input type="checkbox" class="skip-check" id={`skip-${pIdx}-${iIdx}`} />
                                <label for={`skip-${pIdx}-${iIdx}`}>Overslaan</label>
                            </div>
                            <div style="font-size: 10px; color: #999; word-break: break-all;">{img}</div>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </div>

    <div class="export-box" id="exportBtn">Download Configuratie</div>

    <script>
        document.querySelectorAll('.skip-check').forEach(check => {
            check.addEventListener('change', (e) => {
                const card = e.target.closest('.image-card');
                if (e.target.checked) card.classList.add('skipped');
                else card.classList.remove('skipped');
            });
        });

        document.getElementById('exportBtn').addEventListener('click', () => {
            const results = [];
            const inputs = document.querySelectorAll('.name-input');
            
            inputs.forEach(input => {
                const card = input.closest('.image-card');
                const isSkipped = card.querySelector('.skip-check').checked;
                
                if (!isSkipped) {
                    results.push({
                        originalUrl: input.dataset.original,
                        pageUrl: input.dataset.page,
                        newName: input.value || 'unnamed_' + Math.random().toString(36).substr(2, 5)
                    });
                }
            });

            const blob = new Blob([JSON.stringify(results, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const downloadAnchorNode = document.createElement('a');
            downloadAnchorNode.setAttribute("href",     url);
            downloadAnchorNode.setAttribute("download", "image_config.json");
            document.body.appendChild(downloadAnchorNode);
            downloadAnchorNode.click();
            downloadAnchorNode.remove();
            
            alert('Configuratie gedownload! Stuur dit bestand naar mij terug.');
        });
    </script>
</body>
</html>
