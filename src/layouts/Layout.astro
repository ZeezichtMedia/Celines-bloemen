---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import WhatsAppPopup from '../components/common/WhatsAppPopup.astro';
import ScrollToTop from '../components/common/ScrollToTop.astro';
import LenisSetup from '../components/common/LenisSetup.astro';
import { siteConfig } from '../config';
import { getPublicSettings, parseOpeningHours, openingHoursSchema } from '../lib/settings';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	noindex?: boolean;
}

const { title, description = "Celine's Bloemen - Bloemen maken jouw bruiloft, huis en evenement compleet.", ogImage = "/images/logo/celinesbloemenlogo.webp", noindex = false } = Astro.props;
// /winkel en /winkel/ geven allebei de pagina: canonical altijd met slash, zoals in de sitemap
const canonicalURL = new URL(Astro.url.pathname.replace(/\/?$/, '/'), siteConfig.url);
// Mededeling en openingstijden komen uit het beheer (pagina's worden niet vooraf gebouwd)
const settings = await getPublicSettings();
const announcement = settings.announcement.trim();
const openingHours = openingHoursSchema(parseOpeningHours(settings));
---

<!doctype html>
<html lang="nl" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL.href} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, siteConfig.url).href} />
		<meta property="og:locale" content="nl_NL" />
		<meta property="og:site_name" content={siteConfig.name} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, siteConfig.url).href} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">

		<!-- Schema.org LocalBusiness -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Florist",
			"name": siteConfig.name,
			"description": description,
			"url": siteConfig.url,
			"telephone": siteConfig.phone,
			"email": siteConfig.email,
			"image": new URL(ogImage, siteConfig.url).href,
			"address": {
				"@type": "PostalAddress",
				"streetAddress": siteConfig.address.street,
				"postalCode": siteConfig.address.postalCode,
				"addressLocality": siteConfig.address.city,
				"addressRegion": siteConfig.address.province,
				"addressCountry": "NL"
			},
			"openingHoursSpecification": openingHours,
			"sameAs": [siteConfig.instagram, siteConfig.tiktok]
		})} />
	  <!-- Vercel Web Analytics: bezoekers meten zonder cookies, alleen op productie -->
	  {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}
	</head>
	<body class="bg-sand-500 text-forest font-sans antialiased min-h-screen flex flex-col">
		<!-- Skip to content link -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-6 focus:py-3 focus:bg-forest focus:text-white focus:rounded-md focus:outline-none">
			Ga naar inhoud
		</a>
    <LenisSetup />
		{announcement && (
			<div class="bg-forest text-sand-500 text-center text-sm px-6 py-2.5" role="status">
				{announcement}
			</div>
		)}
		<Header />
		<main id="main-content" class="flex-grow">
			<slot />
		</main>
		<Footer />
		<WhatsAppPopup />
		<ScrollToTop />
	</body>
</html>
