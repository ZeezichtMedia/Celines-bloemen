---
const services = [
  {
    title: 'Winkel Arnemuiden',
    description: 'De sfeervolle winkel in het hart van Arnemuiden. Kom langs met je eigen vaas of kies een prachtig cadeau.',
    image: '/images/winkel/winkel-interieur.png',
    link: '/winkel',
    spanClass: 'md:col-span-2 md:row-span-2', // Large block
    aspect: 'aspect-square md:aspect-auto'
  },
  {
    title: 'Verse Boeketten',
    description: 'Dagverse boeketten, met zorg samengesteld en lokaal bezorgd op Walcheren.',
    image: '/images/bruiloft-bloemen/boeket-op-bruloft.jpeg',
    link: '/bestellen',
    spanClass: 'md:col-span-1 md:row-span-1', // Small block 1
    aspect: 'aspect-[4/3] md:aspect-square'
  },
  {
    title: 'Atelier Shop',
    description: 'Bijzondere vazen, keramiek en gereedschap waarmee ik zelf het liefst werk.',
    image: '/images/droogbloemen/droogbloemen-krans-groot.jpeg',
    link: '/webshop',
    spanClass: 'md:col-span-1 md:row-span-1', // Small block 2
    aspect: 'aspect-[4/3] md:aspect-square'
  }
];
---

<section class="py-20 md:py-32 bg-sand-500 overflow-hidden relative px-4 md:px-0">
  <!-- Minimal decorative glass blobs -->
  <div class="absolute top-1/4 left-0 w-96 h-96 bg-sage-500/20 rounded-full blur-[100px] z-0 pointer-events-none"></div>
  <div class="absolute bottom-0 right-10 w-80 h-80 bg-terra-400/20 rounded-full blur-[100px] z-0 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-16 md:mb-20 stagger-reveal">
      <span class="text-xs md:text-sm font-sans font-medium uppercase tracking-widest text-sage-600 mb-3 md:mb-4 block">Mijn Expertise</span>
      <h2 class="font-serif text-4xl md:text-5xl lg:text-7xl text-forest mb-4 md:mb-6">Wat ik doe</h2>
      <p class="font-sans text-forest/70 max-w-2xl mx-auto font-light text-lg md:text-xl leading-relaxed">
        Bij Celine's Bloemen draait alles om ambacht, puurheid en maatwerk.
      </p>
    </div>

    <!-- Responsive Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-6 md:h-[800px] stagger-reveal">
      {services.map((service, index) => (
        <a 
          href={service.link} 
          class={`group relative block overflow-hidden rounded-[2rem] ${service.spanClass} ${service.aspect} bg-sand-600 shadow-sm md:shadow-none hover:shadow-2xl transition-all duration-500`}
          data-cursor="hover"
        >
          <!-- Content wrapper -->
          <div class="w-full h-full relative z-10 p-6 md:p-8 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/40 to-transparent transition-colors duration-500 md:from-black/80 md:via-black/20 md:group-hover:from-black/90 md:group-hover:via-black/40">
            <h3 class="font-serif text-3xl md:text-4xl text-white mb-2 md:mb-3 drop-shadow-md transform transition-transform duration-500 md:group-hover:-translate-y-2">
              {service.title}
            </h3>
            <p class="font-sans text-white/90 font-light leading-relaxed max-w-md drop-shadow max-h-32 opacity-100 md:max-h-0 md:opacity-0 md:group-hover:max-h-32 md:group-hover:opacity-100 transition-all duration-500">
              {service.description}
            </p>
          </div>

          <!-- Background Image with smooth scale on hover -->
          <div class="absolute inset-0 z-0 h-full w-full">
            <img 
              src={service.image} 
              alt={service.title} 
              class="w-full h-full object-cover transform transition-transform duration-1000 scale-100 group-hover:scale-105"
            />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>


