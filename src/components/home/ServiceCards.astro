---
const services = [
  {
    title: 'Winkel Arnemuiden',
    description: 'De sfeervolle winkel in het hart van Arnemuiden. Kom langs met je eigen vaas of kies een prachtig cadeau.',
    image: '/images/winkel/winkel-interieur.png',
    link: '/winkel',
  },
  {
    title: 'Boeket Bestellen',
    description: 'Dagverse boeketten, met zorg samengesteld en lokaal bezorgd op Walcheren.',
    image: '/images/bruiloft-bloemen/boeket-op-bruloft.jpeg',
    link: '/bestellen',
  },
  {
    title: 'Webshop',
    description: 'Bijzondere vazen, keramiek en sfeervolle kandelaren. Landelijk bezorgd.',
    image: '/images/droogbloemen/droogbloemen-krans-groot.jpeg',
    link: '/webshop',
  },
  {
    title: 'Bruiloften & Verhuur',
    description: 'Van persoonlijk bruidsboeket tot de verhuur van kandelaren, backdrops en vazen.',
    image: '/images/bruiloft-bloemen/foto-bruiloft-met-backdrop-en-bloemen.jpeg',
    link: '/bruiloften-verhuur',
  }
];
---

<section class="py-20 md:py-32 bg-sand-500 overflow-hidden relative px-4 md:px-0">
  <!-- Minimal decorative glass blobs -->
  <div class="absolute top-1/4 left-0 w-96 h-96 bg-sage-500/20 rounded-full blur-[100px] z-0 pointer-events-none"></div>
  <div class="absolute bottom-0 right-10 w-80 h-80 bg-terra-400/20 rounded-full blur-[100px] z-0 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-16 md:mb-20 stagger-reveal">
      <span class="text-xs md:text-sm font-sans font-medium uppercase tracking-widest text-sage-600 mb-3 md:mb-4 block">Mijn Expertise</span>
      <h2 class="font-serif text-4xl md:text-5xl lg:text-7xl text-forest mb-4 md:mb-6">Wat ik doe</h2>
      <p class="font-sans text-forest/70 max-w-2xl mx-auto font-light text-lg md:text-xl leading-relaxed">
        Bij Celine's Bloemen draait alles om ambacht, puurheid en maatwerk.
      </p>
    </div>

    <!-- 4 Equal Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger-reveal">
      {services.map((service) => (
        <a
          href={service.link}
          class="group relative block overflow-hidden rounded-[2rem] aspect-[3/4] bg-sand-600 shadow-sm hover:shadow-2xl transition-all duration-500"
          data-cursor="hover"
        >
          <!-- Content wrapper -->
          <div class="w-full h-full relative z-10 p-6 md:p-8 flex flex-col justify-end bg-gradient-to-t from-black/80 via-black/30 to-transparent group-hover:from-black/90 group-hover:via-black/40 transition-colors duration-500">
            <h3 class="font-serif text-2xl md:text-3xl text-white mb-2 drop-shadow-md transform transition-transform duration-500 group-hover:-translate-y-2">
              {service.title}
            </h3>
            <p class="font-sans text-white/90 text-sm font-light leading-relaxed max-w-md drop-shadow max-h-0 opacity-0 group-hover:max-h-32 group-hover:opacity-100 transition-all duration-500">
              {service.description}
            </p>
          </div>

          <!-- Background Image with smooth scale on hover -->
          <div class="absolute inset-0 z-0 h-full w-full">
            <img
              src={service.image}
              alt={service.title}
              loading="lazy"
              class="w-full h-full object-cover transform transition-transform duration-1000 scale-100 group-hover:scale-105"
            />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
