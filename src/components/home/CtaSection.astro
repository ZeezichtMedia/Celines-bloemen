<section class="py-24 bg-sage-500 relative overflow-hidden">
  <!-- Minimal decorative element -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-sage-400 rounded-full mix-blend-multiply opacity-50 blur-3xl transform translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-terra-400 rounded-full mix-blend-multiply opacity-30 blur-3xl transform -translate-x-1/2 translate-y-1/2"></div>

  <div class="max-w-4xl mx-auto px-6 text-center relative z-10 space-y-8 glass-card border-none bg-black/10 p-12 rounded-3xl">
    <h2 class="font-serif text-4xl md:text-5xl text-white stagger-reveal">
      Klaar voor een onvergetelijke sfeer?
    </h2>
    <p class="font-sans text-xl text-sand-500/90 font-light leading-relaxed max-w-2xl mx-auto stagger-reveal">
      Kom gezellig langs in mijn atelier in Zeeland onder het genot van een kopje koffie! Of stuur gewoon even een berichtje, dan denken we samen creatief met jullie mee!
    </p>
    
    <div class="pt-6 stagger-reveal">
      <a href="/contact" data-cursor="hover" class="inline-block px-10 py-5 bg-white text-forest font-sans text-sm tracking-widest uppercase hover:bg-sand-500 transition-colors duration-300 rounded-sm">
        Stuur een berichtje!
      </a>
    </div>
  </div>
</section>
