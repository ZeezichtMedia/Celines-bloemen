---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../../config';

const rows = [
  { title: 'Bekijk de winkel', sub: `${siteConfig.address.street}, ${siteConfig.address.city}`, url: '/winkel' },
  { title: 'Stuur een berichtje', sub: 'Ik denk graag met je mee', url: '/contact' },
  { title: 'App direct', sub: siteConfig.phoneDisplay, url: `https://wa.me/${siteConfig.whatsappNumber}`, external: true },
];
---

<section class="section-lg bg-base-2">
  <div class="container-wide grid gap-12 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-5">
      <p class="eyebrow reveal">Kom langs of stuur een bericht</p>
      <h2 class="reveal mt-6 type-display-md text-ink">Benieuwd geworden?</h2>
      <p class="reveal mt-6 type-lead max-w-md text-ink-muted">
        Kom langs in de winkel in Arnemuiden voor een leuke inkijk. Of stuur even een berichtje, dan denk ik graag met je mee.
      </p>
    </div>
    <div class="reveal-stagger lg:col-span-6 lg:col-start-7">
      {rows.map((r) => (
        <a
          href={r.url}
          target={r.external ? '_blank' : undefined}
          rel={r.external ? 'noopener noreferrer' : undefined}
          class="group flex items-center justify-between gap-4 border-t border-ink/12 py-6 last:border-b transition-colors hover:border-ink/40"
        >
          <span>
            <span class="block font-display text-[1.7rem] leading-tight text-ink">{r.title}</span>
            <span class="mt-1 block text-[0.92rem] text-ink-muted">{r.sub}</span>
          </span>
          <Icon name={r.external ? 'ph:arrow-up-right-light' : 'ph:arrow-right-light'} class="h-6 w-6 shrink-0 text-ink-faint transition group-hover:translate-x-1 group-hover:text-accent-600" />
        </a>
      ))}
    </div>
  </div>
</section>
