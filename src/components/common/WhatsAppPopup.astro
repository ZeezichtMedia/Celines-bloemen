---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../../config';
---

<!-- WhatsApp Floating Button -->
<div id="wa-popup" class="fixed bottom-5 right-5 md:bottom-7 md:right-7 z-[80] flex flex-col items-end gap-3 opacity-0 translate-y-4 transition-all duration-500 pointer-events-none">
  <!-- Tooltip Bubble -->
  <div id="wa-tooltip" class="bg-base border border-line rounded-2xl shadow-[0_24px_48px_-24px_rgb(43_23_18/0.45)] p-4 pr-6 max-w-[250px] relative opacity-0 translate-y-2 transition-all duration-300 pointer-events-none" role="status">
    <button id="wa-tooltip-close" class="absolute -top-2.5 -right-2.5 w-7 h-7 bg-ink text-base rounded-full flex items-center justify-center hover:bg-accent-500 transition-colors pointer-events-auto" aria-label="Tooltip sluiten">
      <Icon name="ph:x-bold" class="w-3 h-3" />
    </button>
    <p class="text-ink text-[0.92rem] leading-relaxed">
      <span class="font-medium">Hoi!</span> Heb je nog vragen? Stuur gerust een berichtje via WhatsApp.
    </p>
    <!-- Triangle pointer -->
    <div class="absolute -bottom-[7px] right-6 w-3.5 h-3.5 bg-base border-r border-b border-line rotate-45" aria-hidden="true"></div>
  </div>

  <!-- WhatsApp Button -->
  <a
    href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hi Celine! Ik heb een vraag.')}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Stuur een WhatsApp bericht"
    class="w-14 h-14 bg-[#25D366] text-white rounded-full flex items-center justify-center shadow-[0_16px_32px_-14px_rgb(0_0_0/0.45)] hover:-translate-y-0.5 transition-transform duration-500 pointer-events-auto"
  >
    <Icon name="ph:whatsapp-logo-fill" class="w-7 h-7" />
  </a>
</div>

<script>
  const initWhatsAppPopup = () => {
    const popup = document.getElementById('wa-popup');
    const tooltip = document.getElementById('wa-tooltip');
    const tooltipClose = document.getElementById('wa-tooltip-close');

    if (!popup || !tooltip || !tooltipClose) return;

    // Abort previous listeners
    const controller = new AbortController();
    const { signal } = controller;
    const prev = (popup as any).__waCleanup;
    if (prev) prev();
    (popup as any).__waCleanup = () => controller.abort();

    const showPopupTimer = setTimeout(() => {
      popup.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      popup.classList.add('opacity-100', 'translate-y-0');

      const showTooltipTimer = setTimeout(() => {
        tooltip.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        tooltip.classList.add('opacity-100', 'translate-y-0');
      }, 2000);

      // Clear tooltip timer on abort
      signal.addEventListener('abort', () => clearTimeout(showTooltipTimer));
    }, 3000);

    // Clear popup timer on abort
    signal.addEventListener('abort', () => clearTimeout(showPopupTimer));

    tooltipClose.addEventListener('click', (e) => {
      e.preventDefault();
      tooltip.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
      tooltip.classList.remove('opacity-100', 'translate-y-0');
    }, { signal });
  };

  initWhatsAppPopup();
  document.addEventListener('astro:page-load', initWhatsAppPopup);
</script>
