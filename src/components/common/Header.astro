---
import { Icon } from 'astro-icon/components';
import CartWidget from '../shop/CartWidget';
import { siteConfig } from '../../config';

interface Props { announcement?: string; shop?: boolean }
const { announcement = '', shop = true } = Astro.props;

// Boeket bestellen en Webshop staan alleen in het menu als online afrekenen aan staat
const links = [
  { name: 'Winkel', url: '/winkel' },
  ...(shop ? [{ name: 'Boeket bestellen', url: '/bestellen' }, { name: 'Webshop', url: '/webshop' }] : []),
  { name: 'Abonnementen', url: '/abonnementen' },
  { name: 'Bruiloften & verhuur', url: '/bruiloften-verhuur' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (url: string) => path === url;
---

<header class="site-header" data-scrolled="false">
  {announcement && (
    <div class="announce bg-ink text-base" role="status">
      <p class="container-wide py-2.5 text-center text-[0.84rem] leading-snug">{announcement}</p>
    </div>
  )}

  <div class="nav-wrap px-3 sm:px-5">
    <div class="nav-pill mx-auto flex items-center justify-between gap-3">
      <a href="/" class="shrink-0" aria-label="Celine's Bloemen, naar de homepagina">
        <img
          src="/images/logo/celinesbloemenlogo-400.webp"
          alt="Celine's Bloemen"
          width="92"
          height="92"
          fetchpriority="high"
          decoding="async"
          class="nav-logo"
        />
      </a>

      <nav class="hidden lg:flex items-center gap-7 xl:gap-9" aria-label="Hoofdnavigatie">
        {links.map((l) => (
          <a href={l.url} class="nav-link whitespace-nowrap" aria-current={isCurrent(l.url) ? 'page' : undefined}>{l.name}</a>
        ))}
      </nav>

      <div class="flex items-center gap-1">
        <a href="/contact" class="nav-cta hidden sm:inline-flex items-center gap-2 rounded-full border border-ink bg-ink px-5 py-2.5 text-[0.9rem] font-medium text-base hover:bg-accent-500 hover:border-accent-500">
          Contact
        </a>
        {shop && (
          <div class="nav-icon text-ink">
            <CartWidget client:load />
          </div>
        )}
        <button
          id="menu-open"
          type="button"
          class="nav-icon lg:hidden flex h-11 w-11 items-center justify-center rounded-full text-ink"
          aria-label="Menu openen"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="ph:list-light" class="h-7 w-7" />
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Menu op de telefoon -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[70] flex flex-col bg-base opacity-0 pointer-events-none transition-opacity duration-500 lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  data-lenis-prevent
>
  <div class="flex items-center justify-between px-5 py-4">
    <img src="/images/logo/celinesbloemenlogo-400.webp" alt="" width="56" height="56" class="h-14 w-auto" />
    <button id="menu-close" type="button" class="flex h-11 w-11 items-center justify-center rounded-full text-ink" aria-label="Menu sluiten">
      <Icon name="ph:x-light" class="h-7 w-7" />
    </button>
  </div>

  <nav class="flex flex-1 flex-col justify-center px-7" aria-label="Menu">
    <ul class="space-y-1">
      {[{ name: 'Home', url: '/' }, ...links, { name: 'Over mij', url: '/over-mij' }, { name: 'Contact', url: '/contact' }].map((l, i) => (
        <li class="menu-item">
          <a href={l.url} class="flex items-baseline gap-4 py-2" aria-current={isCurrent(l.url) ? 'page' : undefined}>
            <span class="w-6 text-xs tabular-nums text-accent-600">{String(i + 1).padStart(2, '0')}</span>
            <span class:list={['font-display text-[2.1rem] leading-tight', isCurrent(l.url) ? 'text-accent-600' : 'text-ink']}>{l.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="border-t border-line px-7 py-6 text-sm text-ink-muted">
    <p>{siteConfig.address.street}, {siteConfig.address.city}</p>
    <a href={`tel:${siteConfig.phone}`} class="mt-1 inline-block text-ink">{siteConfig.phoneDisplay}</a>
  </div>
</div>

<style>
  #mobile-menu .menu-item { opacity: 0; transform: translateY(14px); transition: opacity 0.6s cubic-bezier(0.16,1,0.3,1), transform 0.6s cubic-bezier(0.16,1,0.3,1); }
  #mobile-menu.is-open { opacity: 1; pointer-events: auto; }
  #mobile-menu.is-open .menu-item { opacity: 1; transform: none; }
  #mobile-menu.is-open .menu-item:nth-child(2) { transition-delay: 40ms; }
  #mobile-menu.is-open .menu-item:nth-child(3) { transition-delay: 80ms; }
  #mobile-menu.is-open .menu-item:nth-child(4) { transition-delay: 120ms; }
  #mobile-menu.is-open .menu-item:nth-child(5) { transition-delay: 160ms; }
  #mobile-menu.is-open .menu-item:nth-child(6) { transition-delay: 200ms; }
  #mobile-menu.is-open .menu-item:nth-child(7) { transition-delay: 240ms; }
  #mobile-menu.is-open .menu-item:nth-child(8) { transition-delay: 280ms; }
</style>

<script>
  const menu = document.getElementById('mobile-menu');
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');

  const setOpen = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.classList.toggle('is-open', open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) window.__siteLenis?.stop(); else window.__siteLenis?.start();
    if (open) closeBtn?.focus();
  };

  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
