---
import { siteConfig } from '../../config';
const currentYear = new Date().getFullYear();
---

<footer class="bg-forest text-sand-500 py-12 md:py-16 mt-auto">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8">
    
    <!-- Brand Info -->
    <div>
      <a href="/" class="inline-block mb-6 w-36 md:w-48 group">
        <img 
          src="/images/logo/celinesbloemenlogo.webp" 
          alt="Celine's Bloemen Logo" 
          class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
        />
      </a>
      <p class="text-sand-600 font-light leading-relaxed max-w-sm mb-6">
        Bloemen maken jouw bruiloft, huis en evenement compleet. Van eigen kweek en volledig puur natuur.
      </p>
      <div class="flex gap-4">
        <a href={siteConfig.instagram} target="_blank" rel="noopener noreferrer" aria-label="Volg ons op Instagram" class="w-10 h-10 rounded-full border border-sand-600 flex items-center justify-center hover:bg-sage-600 hover:border-sage-600 transition-colors duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href={siteConfig.tiktok} target="_blank" rel="noopener noreferrer" aria-label="Volg ons op TikTok" class="w-10 h-10 rounded-full border border-sand-600 flex items-center justify-center hover:bg-sage-600 hover:border-sage-600 transition-colors duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.51a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.63a8.23 8.23 0 0 0 4.76 1.5v-3.4a4.85 4.85 0 0 1-1-.04z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="md:pl-12">
      <h4 class="font-sans text-xs md:text-sm tracking-widest uppercase text-sage-400 mb-4 md:mb-6 font-medium">Navigatie</h4>
      <ul class="flex flex-col gap-3 font-light">
        <li><a href="/" class="hover:text-sage-400 transition-colors duration-300">Home</a></li>
        <li><a href="/winkel" class="hover:text-sage-400 transition-colors duration-300">Winkel Arnemuiden</a></li>
        <li><a href="/bestellen" class="hover:text-sage-400 transition-colors duration-300">Boeket Bestellen</a></li>
        <li><a href="/webshop" class="hover:text-sage-400 transition-colors duration-300">Landelijke Webshop</a></li>
        <li><a href="/abonnementen" class="hover:text-sage-400 transition-colors duration-300">Abonnementen</a></li>
        <li><a href="/bruiloften-verhuur" class="hover:text-sage-400 transition-colors duration-300">Bruiloften & Verhuur</a></li>
        <li><a href="/contact" class="hover:text-sage-400 transition-colors duration-300">Contact</a></li>
      </ul>
    </div>

    <!-- Contact Info -->
    <div>
      <h4 class="font-sans text-xs md:text-sm tracking-widest uppercase text-sage-400 mb-4 md:mb-6 font-medium">Contact</h4>
      <ul class="flex flex-col gap-4 font-light text-sand-600">
        <li class="flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 text-sage-400 shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Winkel Arnemuiden:<br/>Langstraat 81, 4341 ED</span>
        </li>
        <li class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-sage-400 shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          <a href={`mailto:${siteConfig.email}`} class="hover:text-white transition-colors duration-300">{siteConfig.email}</a>
        </li>
        <li class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-sage-400 shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <a href={`tel:${siteConfig.phone}`} class="hover:text-white transition-colors duration-300">{siteConfig.phoneDisplay}</a>
        </li>
      </ul>
    </div>

  </div>
  
  <div class="max-w-7xl mx-auto px-6 mt-12 md:mt-16 pt-8 border-t border-sand-600/30 flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-sand-600/60 font-light text-center md:text-left">
    <p>&copy; {currentYear} Celine's Bloemen. Alle rechten voorbehouden.</p>

    <!-- Agensea credit — premium signature -->
    <a
      href="https://agensea.nl"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Website ontworpen en gebouwd door Agensea"
      class="agensea-credit group inline-flex items-center gap-3"
    >
      <span class="credit-label">Crafted by</span>
      <img
        src="/brand/agensea-logo.svg"
        alt="Agensea"
        width="140"
        height="37"
        class="credit-logo"
        loading="lazy"
        decoding="async"
      />
      <span class="credit-arrow" aria-hidden="true">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M17 7H8M17 7V16"/>
        </svg>
      </span>
    </a>
  </div>
</footer>

<style>
  /* ── Agensea premium credit ───────────────────────────────────
     Echte brand-logo in witte uitvoering. Rust: subtiel,
     70% opacity, discreet. Hover: logo wordt 100% wit én krijgt
     een zachte indigo glow (signature accent-kleur) eromheen.
     Label fade't in, arrow schuift uit — alles in sync. */
  .agensea-credit {
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .agensea-credit:focus-visible {
    outline: 2px solid #2D3FE0;
    outline-offset: 6px;
    border-radius: 2px;
  }

  .credit-label {
    font-family: 'Space Grotesk', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.5;
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .credit-logo {
    height: 24px;
    width: auto;
    /* Echte logo wit maken + subtiele default state */
    filter: brightness(0) invert(1);
    opacity: 0.8;
    transition:
      opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 500ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left center;
    will-change: filter, transform;
  }

  .credit-arrow {
    display: inline-flex;
    align-items: center;
    color: #2D3FE0;
    opacity: 0;
    transform: translate(-6px, 2px);
    transition: all 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hover state — alles in sync op 500ms, één easing */
  .agensea-credit:hover .credit-label {
    opacity: 0.9;
  }

  .agensea-credit:hover .credit-logo {
    opacity: 1;
    /* Wit blijft wit, plus signature-indigo glow eromheen.
       Drie gestapelde drop-shadows = zachte aura die zichtbaar is
       tegen donkere achtergronden zoals bg-forest. */
    filter:
      brightness(0)
      invert(1)
      drop-shadow(0 0 2px rgba(67, 83, 255, 0.9))
      drop-shadow(0 0 10px rgba(67, 83, 255, 0.75))
      drop-shadow(0 0 24px rgba(67, 83, 255, 0.55));
    transform: scale(1.04);
  }

  .agensea-credit:hover .credit-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .credit-label,
    .credit-logo,
    .credit-arrow {
      transition: opacity 200ms ease;
    }
    .agensea-credit:hover .credit-logo {
      transform: none;
    }
  }
</style>
