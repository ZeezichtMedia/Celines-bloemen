---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../../config';
import { WEEKDAYS, type DayHours } from '../../lib/settings';

interface Props { hours: DayHours[] }
const { hours } = Astro.props;
const currentYear = new Date().getFullYear();
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${siteConfig.address.street}, ${siteConfig.address.postalCode} ${siteConfig.address.city}`)}`;

const nav = [
  { name: 'Winkel Arnemuiden', url: '/winkel' },
  { name: 'Boeket bestellen', url: '/bestellen' },
  { name: 'Webshop', url: '/webshop' },
  { name: 'Abonnementen', url: '/abonnementen' },
  { name: 'Bruiloften & verhuur', url: '/bruiloften-verhuur' },
  { name: 'Over mij', url: '/over-mij' },
  { name: 'Contact', url: '/contact' },
];
---

<footer class="grain relative mt-auto overflow-hidden bg-dark text-base/70">
  <div class="container-wide relative z-10 pt-20 md:pt-28">
    <div class="grid gap-10 border-b border-base/10 pb-16 md:pb-20 lg:grid-cols-12 lg:items-end">
      <h2 class="type-display-lg text-base lg:col-span-8">Kom gezellig langs in de winkel in Arnemuiden.</h2>
      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-4 lg:justify-end">
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-primary btn-light">
          Route plannen <Icon name="ph:arrow-up-right-light" class="ico h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" class="inline-block" aria-label="Celine's Bloemen, naar de homepagina">
          <img src="/images/logo/celinesbloemenlogo-400.webp" alt="Celine's Bloemen" width="128" height="128" loading="lazy" decoding="async" class="h-32 w-auto brightness-0 invert opacity-90" />
        </a>
        <p class="mt-6 max-w-xs text-[0.95rem] font-light leading-relaxed">
          Bloemen maken jouw huis, bruiloft of evenement compleet. Verse bloemen, droogbloemen of kunstbloemen, voor alles kun je terecht bij Celine's Bloemen.
        </p>
        <div class="mt-7 flex gap-2">
          <a href={siteConfig.instagram} target="_blank" rel="noopener noreferrer" aria-label="Celine's Bloemen op Instagram" class="flex h-11 w-11 items-center justify-center rounded-full border border-base/20 text-base transition hover:border-accent-300 hover:text-accent-300">
            <Icon name="ph:instagram-logo-light" class="h-5 w-5" />
          </a>
          <a href={siteConfig.tiktok} target="_blank" rel="noopener noreferrer" aria-label="Celine's Bloemen op TikTok" class="flex h-11 w-11 items-center justify-center rounded-full border border-base/20 text-base transition hover:border-accent-300 hover:text-accent-300">
            <Icon name="ph:tiktok-logo-light" class="h-5 w-5" />
          </a>
          <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" aria-label="Stuur Celine een WhatsApp-bericht" class="flex h-11 w-11 items-center justify-center rounded-full border border-base/20 text-base transition hover:border-accent-300 hover:text-accent-300">
            <Icon name="ph:whatsapp-logo-light" class="h-5 w-5" />
          </a>
        </div>
      </div>

      <div class="lg:col-span-3">
        <p class="eyebrow-bone">Openingstijden</p>
        <ul class="mt-6 space-y-1.5 text-[0.95rem] font-light">
          {hours.map((h, i) => (
            <li class:list={['flex justify-between gap-6', !h && 'text-base/40']}>
              <span>{WEEKDAYS[i].nl}</span>
              <span class="tabular-nums">{h ? `${h.open} tot ${h.close}` : 'Gesloten'}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-2 lg:col-start-9">
        <p class="eyebrow-bone">Contact</p>
        <ul class="mt-6 space-y-3 text-[0.95rem] font-light">
          <li><a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="transition hover:text-base">{siteConfig.address.street}<br />{siteConfig.address.postalCode} {siteConfig.address.city}</a></li>
          <li><a href={`tel:${siteConfig.phone}`} class="transition hover:text-base">{siteConfig.phoneDisplay}</a></li>
          <li><a href={`mailto:${siteConfig.email}`} class="break-all transition hover:text-base">{siteConfig.email}</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <p class="eyebrow-bone">Ontdek</p>
        <ul class="mt-6 space-y-2 text-[0.95rem] font-light">
          {nav.map((l) => <li><a href={l.url} class="transition hover:text-base">{l.name}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-6 border-t border-base/10 py-8 text-[0.82rem] text-base/50 md:flex-row md:items-center md:justify-between">
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <span>&copy; {currentYear} Celine's Bloemen</span>
        {siteConfig.kvk && <span>KvK {siteConfig.kvk}</span>}
        {siteConfig.btw && <span>Btw {siteConfig.btw}</span>}
        <a href="/algemene-voorwaarden" class="transition hover:text-base">Algemene voorwaarden</a>
        <a href="/privacy" class="transition hover:text-base">Privacyverklaring</a>
      </p>
      <a
        href="https://agensea.nl"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Website ontworpen en gebouwd door Agensea"
        class="agensea-credit group inline-flex items-center gap-3"
      >
        <span class="credit-label">Crafted by</span>
        <img src="/brand/agensea-logo.svg" alt="Agensea" width="140" height="37" class="credit-logo" loading="lazy" decoding="async" />
        <span class="credit-arrow" aria-hidden="true">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M17 7H8M17 7V16"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  /* ── Agensea premium credit ───────────────────────────────────
     Echte brand-logo in witte uitvoering. Rust: subtiel,
     70% opacity, discreet. Hover: logo wordt 100% wit én krijgt
     een zachte indigo glow (signature accent-kleur) eromheen.
     Label fade't in, arrow schuift uit — alles in sync. */
  .agensea-credit {
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .agensea-credit:focus-visible {
    outline: 2px solid #2D3FE0;
    outline-offset: 6px;
    border-radius: 2px;
  }

  .credit-label {
    font-family: 'Space Grotesk', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.5;
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .credit-logo {
    height: 24px;
    width: auto;
    /* Echte logo wit maken + subtiele default state */
    filter: brightness(0) invert(1);
    opacity: 0.8;
    transition:
      opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 500ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left center;
    will-change: filter, transform;
  }

  .credit-arrow {
    display: inline-flex;
    align-items: center;
    color: #2D3FE0;
    opacity: 0;
    transform: translate(-6px, 2px);
    transition: all 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hover state — alles in sync op 500ms, één easing */
  .agensea-credit:hover .credit-label {
    opacity: 0.9;
  }

  .agensea-credit:hover .credit-logo {
    opacity: 1;
    /* Wit blijft wit, plus signature-indigo glow eromheen.
       Drie gestapelde drop-shadows = zachte aura die zichtbaar is
       tegen donkere achtergronden zoals bg-dark. */
    filter:
      brightness(0)
      invert(1)
      drop-shadow(0 0 2px rgba(67, 83, 255, 0.9))
      drop-shadow(0 0 10px rgba(67, 83, 255, 0.75))
      drop-shadow(0 0 24px rgba(67, 83, 255, 0.55));
    transform: scale(1.04);
  }

  .agensea-credit:hover .credit-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .credit-label,
    .credit-logo,
    .credit-arrow {
      transition: opacity 200ms ease;
    }
    .agensea-credit:hover .credit-logo {
      transform: none;
    }
  }
</style>
