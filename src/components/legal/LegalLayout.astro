---
// Gedeelde opmaak voor voorwaarden en privacyverklaring
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config';

interface Props { title: string; eyebrow: string; description: string; updated: string }
const { title, eyebrow, description, updated } = Astro.props;
---

<Layout title={`${title} - Celine's bloemen`} description={description}>
  <section class="page-top pb-12 md:pb-16">
    <div class="container-tight">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-6 type-display-lg text-ink">{title}</h1>
      <p class="mt-5 text-sm text-ink-faint">Laatst bijgewerkt: {updated}</p>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <article class="legal container-tight border-t border-line pt-12 text-[1.05rem] font-light leading-relaxed text-ink-soft">
      <slot />
      <div class="mt-12 border-t border-line pt-8 text-sm text-ink-muted">
        <p class="font-medium text-ink">{siteConfig.legalName}</p>
        <p>{siteConfig.address.street}, {siteConfig.address.postalCode} {siteConfig.address.city}</p>
        <p>{siteConfig.email} · {siteConfig.phoneDisplay}</p>
        <p>KvK: {siteConfig.kvk || '[KvK-nummer invullen]'} · Btw-id: {siteConfig.btw || '[btw-nummer invullen]'}</p>
      </div>
    </article>
  </section>
</Layout>

<style>
  .legal :global(h2) { font-family: var(--font-display); font-weight: 500; font-size: 1.9rem; line-height: 1.15; color: var(--color-ink); margin: 2.75rem 0 1rem; }
  .legal :global(h2:first-child) { margin-top: 0; }
  .legal :global(p) { margin: 0 0 1rem; }
  .legal :global(ul) { margin: 0 0 1rem 1.25rem; list-style: disc; }
  .legal :global(li) { margin-bottom: 0.4rem; }
  .legal :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .legal :global(strong) { font-weight: 500; color: var(--color-ink); }
</style>
