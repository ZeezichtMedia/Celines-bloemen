# ============================================================
# Celine's Bloemen — Environment Variables
# Kopieer dit bestand naar .env en vul de waarden in
# ============================================================

# --- Site ---
SITE_URL=http://localhost:4321

# --- Admin Panel ---
# Wachtwoord voor /admin login (verplicht, geen fallback)
ADMIN_PASSWORD=
# Geheime sleutel voor sessie cookies (genereer met: openssl rand -hex 32)
SESSION_SECRET=

# --- Database (Vercel Postgres) ---
# Wordt automatisch ingesteld bij koppeling via Vercel dashboard
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Mollie (Betalingen) ---
# Dashboard: https://my.mollie.com → Developers → API keys
# Gebruik test key (test_xxx) voor development, live key (live_xxx) voor productie
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- E-mail (SMTP via Mijnhost/DirectAdmin) ---
# Maak een e-mailaccount aan in DirectAdmin, bijv. noreply@celinesbloemen.nl
SMTP_HOST=mail.celinesbloemen.nl
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@celinesbloemen.nl
SMTP_PASS=
SMTP_FROM="Celine's Bloemen <noreply@celinesbloemen.nl>"

# --- Vercel Blob (Foto uploads) ---
# Wordt automatisch ingesteld bij koppeling via Vercel dashboard
BLOB_READ_WRITE_TOKEN=
